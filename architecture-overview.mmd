flowchart TB
    FE["examio-fe<br/>React + Vite + React Router<br/>Zustand + Axios"] -->|HTTP / SSE| GW["gateway-service<br/>Public API / Proxy"]

    GW --> AUTH["auth-service<br/>auth / profile / session / OAuth"]
    GW --> CONTENT["content-service<br/>quiz / flashcard / generation jobs"]
    GW --> ASSESS["assessment-service<br/>exam room / session / attempt"]
    GW --> FIN["finance-service<br/>wallet / payment / subscription"]
    GW --> R2S["r2-service<br/>file / storage API"]
    GW --> AI["ai-service<br/>FastAPI / RAG / generation / chat"]
    GW --> OCR["ocr-service<br/>OCR processing"]

    AUTH -->|USER_CREATED event| MQ[(RabbitMQ)]
    MQ -->|consume event| FIN

    CONTENT <-->|events / gRPC ListModels| AI
    CONTENT -->|storage integration| R2S
    ASSESS -->|gRPC quiz snapshot| CONTENT
    R2S --> R2[(Cloudflare R2)]

    COMMON["libs/common<br/>guards / events / grpc / utils"]
    DBLIB["libs/database<br/>Prisma schema + client"]
    REDISLIB["libs/redis<br/>shared Redis module"]

    COMMON -. shared .-> AUTH
    COMMON -. shared .-> CONTENT
    COMMON -. shared .-> ASSESS
    COMMON -. shared .-> FIN
    COMMON -. shared .-> R2S
    COMMON -. shared .-> GW

    DBLIB -. shared .-> AUTH
    DBLIB -. shared .-> CONTENT
    DBLIB -. shared .-> ASSESS
    DBLIB -. shared .-> FIN
    DBLIB -. shared .-> GW

    REDISLIB -. shared .-> AUTH
    REDISLIB -. shared .-> CONTENT
    REDISLIB -. shared .-> ASSESS
    REDISLIB -. shared .-> FIN
    REDISLIB -. shared .-> GW

    DBLIB --> PG[(Prisma / Postgres)]
    REDISLIB --> REDIS[(Redis)]

    classDef app fill:#e8f1ff,stroke:#4a7bd1,color:#0f172a
    classDef infra fill:#eefbf3,stroke:#22a06b,color:#0f172a
    classDef shared fill:#fff7e6,stroke:#d97706,color:#0f172a

    class FE,GW,AUTH,CONTENT,ASSESS,FIN,R2S,AI,OCR app
    class MQ,R2,PG,REDIS infra
    class COMMON,DBLIB,REDISLIB shared
