# docker-development/.env - YOUR keys for external services (copied to ./.env on the first
# `./project up`; gitignored). Everything else (database, broker, JWT, service secrets) is generated
# into .generated/secrets.env. A key left empty does not stop `up`: only the feature that needs it fails.
# One KEY=value per line; quotes optional; no single quote inside a value; no multi-line values.

# Cloudflare R2 (uploads, images, documents). R2_ALLOWED_HOSTS defaults to the host of R2_ENDPOINT.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
# R2_ALLOWED_HOSTS=

# AI (ai-service): comma-separated Gemini keys and model names; optional OpenAI-compatible fallback key.
GEMINI_API_KEYS=
GEMINI_MODEL_NAMES=
AI2_API_KEY=

# Google login (callback: http://localhost:5173/api/v1/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin bootstrap: these emails become system admins on auth start-up and in `./project seed`.
ADMIN_EMAILS=
# Optional: password of bootstrapped admins and seeded dev users (default: generated, see
# ADMIN_DEFAULT_PASSWORD in .generated/secrets.env).
# ADMIN_DEFAULT_PASSWORD=

# Optional overrides.
# VITE_MEASUREMENT_ID=
# VITE_GENAI_TUTOR_ALLOWED_EMAILS=
