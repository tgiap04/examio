{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "monorepo": true,
    "sourceRoot": "apps/assessment-service/src",
    "entryFile": "main",
    "language": "ts",
    "generateOptions": {
        "spec": false
    },
    "compilerOptions": {
        "manualRestart": true,
        "tsConfigPath": "apps/assessment-service/tsconfig.app.json",
        "webpack": true,
        "deleteOutDir": true,
        "assets": [
            {
                "include": "templates/**/*",
                "outDir": "dist",
                "watchAssets": true
            }
        ],
        "watchAssets": true,
        "plugins": []
    },
    "root": "apps/codecraft-be",
    "projects": {
        "ai-service": {
            "type": "application",
            "root": "apps/ai-service",
            "entryFile": "main",
            "sourceRoot": "apps/ai-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/ai-service/tsconfig.app.json"
            }
        },
        "auth-service": {
            "type": "application",
            "root": "apps/auth-service",
            "entryFile": "main",
            "sourceRoot": "apps/auth-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/auth-service/tsconfig.app.json",
                "assets": [
                    {
                        "include": "../../templates/**/*",
                        "outDir": "dist/apps/auth-service",
                        "watchAssets": true
                    },
                    {
                        "include": "../../../proto/kmaedu/auth/**/*.proto",
                        "outDir": "dist/apps/auth-service/proto/kmaedu/auth"
                    },
                    {
                        "include": "../../../proto/kmaedu/common/**/*.proto",
                        "outDir": "dist/apps/auth-service/proto/kmaedu/common"
                    },
                    {
                        "include": "../../../proto/kmaedu/r2/**/*.proto",
