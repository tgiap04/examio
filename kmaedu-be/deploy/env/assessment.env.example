# assessment-service - deploy/env/assessment.env (copy from this file; never commit the real one).
# Only what assessment-service reads at runtime and compose does NOT set. Compose already sets the wiring
# (ports, DATABASE_URL, REDIS_*, RABBITMQ_URL, *_GRPC_URL, JWT_*, SERVICE_CLIENT_SECRET) from deploy/.env.
# Empty KEY= lines are required values; commented lines are optional tunables with their default.

# Exam token signing and answer encryption (assessment-service only).
QUIZ_JWT_SECRET=
# 32 characters.
QUIZ_AES_KEY=
