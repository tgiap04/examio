# auth - deploy/env/auth.env (copy from this file; never commit the real one).
# Only what auth reads at runtime and compose does NOT set. Compose already sets the wiring
# (ports, DATABASE_URL, REDIS_*, RABBITMQ_URL, *_GRPC_URL, JWT_*, SERVICE_CLIENT_SECRET) from deploy/.env.
# Empty KEY= lines are required values; commented lines are optional tunables with their default.

# Boot-time admin bootstrap. The dev `seed` one-shot reads this same file, so seeded users share the password.
ADMIN_EMAILS=
# Default password for NEW admin users created by bootstrap (min 16 chars).
ADMIN_DEFAULT_PASSWORD=
# Encrypts refresh tokens at rest (AES-256). Min 32 chars, distinct per env; auth refuses to boot without it.
REFRESH_TOKEN_ENC_KEY=
# Mail (required in production unless MAIL_TRANSPORT=json).
EMAIL_USER=
EMAIL_PASS=
# Google OAuth (login with Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Optional.
# Comma list of app redirect schemes/URLs accepted after OAuth (open-redirect allow-list).
# OAUTH_ALLOWED_APP_REDIRECTS=kmaedu://
# Cookie domain for the Google flow in production.
# COOKIE_DOMAIN=.kmaedu.fayedark.com
# Access-token lifetime.
# ACCESS_TOKEN_EXPIRATION=15m
