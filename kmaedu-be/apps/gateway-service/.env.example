# Gateway Service Environment Variables

# Server
PORT=3000
NODE_ENV=development
# GatewayControl gRPC server (RevokeSession, InvalidateUser, SetPageFlags); local ports are one per service
GRPC_PORT=50052
FRONTEND_URL=http://localhost:5173

# Services URLs (local dev)
AUTH_SERVICE_URL=http://localhost:3001
CONTENT_SERVICE_URL=http://localhost:3013
ASSESSMENT_SERVICE_URL=http://localhost:3014
STUDYROOM_SERVICE_URL=http://localhost:3009
VOCABULARY_SERVICE_URL=http://localhost:3010
DOCUMENT_SERVICE_URL=http://localhost:3011
AICHAT_SERVICE_URL=http://localhost:3012
ADMIN_SERVICE_URL=http://localhost:7006

# Redis (for rate limiting session storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ: broker user `gateway` (consumes gateway.events: auth.user.authz_changed,
# auth.session.revoked); required at boot
RABBITMQ_URL=amqp://gateway:password@localhost:5672

# Stateless auth (@kmaedu/auth-jwt): tokens are verified against auth's JWKS.
JWT_ISSUER=kmaedu-auth
JWT_AUDIENCE=kmaedu
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
