# R2 Storage Service Environment Variables

# Server
# Local dev only: services share one host, so ports are distinct. In containers
# every service listens on HTTP 3000 + gRPC 50051 (see deploy/docker-compose.yml).
PORT=3004
NODE_ENV=development

# gRPC
GRPC_PORT=50054

# Cloudflare R2 Configuration
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=examio
R2_ACCOUNT_ID=your_account_id
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://examio-r2.fayedark.com

# Comma-separated list of R2 key prefixes that hold private user content
# (AI uploads, teacher documents, etc.). Keys under these prefixes are served
# via short-lived presigned URLs instead of the permanent public URL.
R2_PRIVATE_PREFIXES=ai-uploads,ai-teacher,documents

# Stateless auth (@kmaedu/auth-jwt): tokens are verified against auth's JWKS.
JWT_ISSUER=kmaedu-auth
JWT_AUDIENCE=kmaedu
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
