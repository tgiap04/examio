# Content Service Environment Variables

# Server
# Local dev only: services share one host, so ports are distinct. In containers
# every service listens on HTTP 3000 + gRPC 50051 (see deploy/compose/content.yml).
PORT=3013
GRPC_PORT=50057
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# api | worker | api,worker
#   worker = outbox relay (content.generation.requested, content.quizset.deleted),
#            generation reaper / refund sweeper / watchdog and the r2_delete_tasks poller
ROLE=api,worker

# Database (role content_svc, schema content)
DATABASE_URL="postgresql://content_svc:password@localhost:5432/kmaedu?schema=content"

# Redis (every key starts with `content:`: caches, generation locks, profile cache `content:cache:user:<id>`)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ: broker user `content` (publishes ^content\. only; consumes content.events:
# ai.generation.completed|failed, document.deleted, auth.user.updated)
RABBITMQ_URL=amqp://content:password@localhost:5672

# gRPC clients
#   document-service (CreateUpload, GetDocumentsByIds, ...) with the forwarded user token only
#   r2-service UploadFile (thumbnails) and DeleteObjects (worker) as svc:content
#   vocabulary-service GetWordFamily and auth-service (profiles, user search) as the caller / svc:content
#   ai-service ListModels as svc:content (audience ai)
DOCUMENT_GRPC_URL=localhost:50056
R2_GRPC_URL=localhost:50054
VOCABULARY_GRPC_URL=localhost:50055
AUTH_GRPC_URL=localhost:50051
AI_GRPC_URL=localhost:50058
# Public base of R2 objects (tells an R2-hosted thumbnail from an external URL)
R2_PUBLIC_URL=
# Cloudflare Turnstile secret (flashcard study/with-code bot check)
TURNSTILE_SECRET_KEY=
# Minutes after which a QUEUED / PROCESSING generation job that did not change state is failed (default 60, min 10)
GENERATION_JOB_TIMEOUT_MINUTES=60

# Stateless auth (@kmaedu/auth-jwt): tokens are verified against auth's JWKS.
JWT_ISSUER=kmaedu-auth
JWT_AUDIENCE=kmaedu
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Service-to-service tokens (this service's own secret; auth only holds its hash under `content`).
AUTH_TOKEN_URL=http://localhost:3001/internal/token
SERVICE_CLIENT_SECRET=<printed-by-gen-service-secret>
