// document-service schema (database-per-service, phase 15). Postgres schema `document`,
// role `document_svc`. No relation or FK may point at a model owned by another service:
// `userId String` + `@@index` instead. Derived data (chunks, vectors, graph) lives in
// ai-service; generated history lives in exam/content. They hold `storageId` only.
generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    engineType   = "client"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// One uploaded file. `processingStatus`:
//   PENDING         accepted, waiting for ai-service (quick-upload: not processed yet)
//   PROCESSING | COMPLETED | FAILED
model UserStorage {
    id               String    @id
    userId           String
    filename         String
    url              String
    mimetype         String
    size             Int
    keyR2            String    @unique
    processingStatus String    @default("PENDING")
    // When `document.uploaded` was last written to the outbox; null = never queued
    // (quick-upload waits for the first chat message). EnsureProcessed re-emits on this.
    queuedAt         DateTime?
    // Pages found by OCR (`ai.document.processed`); 0 while unknown.
    pageCount        Int       @default(0)
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @default(now()) @updatedAt

    @@index([userId, createdAt])
    @@index([userId, filename, size])
    @@index([processingStatus, createdAt])
}

// R2 objects queued for deletion in the same tx as the row delete; the worker role
// (libs/messaging r2-delete) drains it. Raw SQL: `r2_delete_tasks`.
model R2DeleteTask {
    id            String   @id @default(uuid()) @db.Uuid
    key           String
    attempts      Int      @default(0)
    nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
    lastError     String?  @map("last_error")
    createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    @@index([nextAttemptAt])
    @@map("r2_delete_tasks")
}

// Transactional outbox + idempotent-consumer ledger (libs/messaging).
model OutboxEvent {
    seq           BigInt    @id @default(autoincrement())
    id            String    @unique
    source        String
    type          String
    envelope      Json
    attempts      Int       @default(0)
    nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
    lockedUntil   DateTime? @map("locked_until")
    lastError     String?   @map("last_error")
    createdAt     DateTime  @default(now()) @map("created_at")
    publishedAt   DateTime? @map("published_at")

    // The relay's partial index (WHERE published_at IS NULL) lives only in the
    // migration SQL: Prisma cannot express it, and declaring a plain @@index here
    // makes `prisma migrate diff` report permanent drift against the partial one.
    @@map("outbox_events")
}

model ProcessedEvent {
    consumer    String
    eventId     String   @map("event_id")
    processedAt DateTime @default(now()) @map("processed_at")

    @@id([consumer, eventId])
    @@index([processedAt])
    @@map("processed_events")
}
