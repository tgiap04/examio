# Document Service Environment Variables

# Server
# Local dev only: services share one host, so ports are distinct. In containers
# every service listens on HTTP 3000 / gRPC 50051 (see deploy/compose/document.yml).
PORT=3011
GRPC_PORT=50056
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# api | worker | api,worker (worker = outbox relay, document.events consumer
# and the r2_delete_tasks worker)
ROLE=api,worker

# Database (role document_svc, schema document)
DATABASE_URL="postgresql://document_svc:password@localhost:5432/kmaedu?schema=document"

# RabbitMQ: broker user `document` (publishes ^document\. only, reads document.events)
RABBITMQ_URL=amqp://document:password@localhost:5672

# gRPC: r2-service (UploadFile, CreatePresignedDownload, DeleteObjects as svc:document)
R2_GRPC_URL=localhost:50054
# Public base of R2 objects (the `url` stored with each upload)
R2_PUBLIC_URL=

# Stateless auth (@kmaedu/auth-jwt): tokens are verified against auth's JWKS.
JWT_ISSUER=kmaedu-auth
JWT_AUDIENCE=kmaedu
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Service-to-service tokens (this service's own secret; auth only holds its hash).
AUTH_TOKEN_URL=http://localhost:3001/internal/token
SERVICE_CLIENT_SECRET=<printed-by-gen-service-secret>
