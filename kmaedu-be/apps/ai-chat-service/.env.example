# AI Chat Service Environment Variables

# Server
# Local dev only: services share one host, so ports are distinct. In containers
# the service listens on HTTP 3000 (see deploy/compose/ai-chat.yml). No gRPC server.
PORT=3012
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# api | worker | api,worker (worker = the r2_delete_tasks poller for message images)
ROLE=api,worker

# Database (role aichat_svc, schema aichat)
DATABASE_URL="postgresql://aichat_svc:password@localhost:5432/kmaedu?schema=aichat"

# Redis (prefix aichat:)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ: broker user `aichat` (consumes aichat.events: document.deleted;
# may publish nothing)
RABBITMQ_URL=amqp://aichat:password@localhost:5672

# gRPC clients
#   ai-service AiService.Query / StreamChat as svc:ai-chat (service token, audience ai)
#   document-service (AssertOwnership, GetDocumentsByIds, EnsureProcessed, DeleteDocuments) as the caller
#   r2-service DeleteObjects as svc:ai-chat (worker)
AI_GRPC_URL=localhost:50058
DOCUMENT_GRPC_URL=localhost:50056
R2_GRPC_URL=localhost:50054
# Public base of R2 objects (tells an R2-hosted message image from an external URL)
R2_PUBLIC_URL=

# How long one message waits for its documents' OCR before answering without them (ms, default 120000)
AI_CHAT_DOCUMENT_WAIT_MS=120000

# Stateless auth (@kmaedu/auth-jwt): tokens are verified against auth's JWKS.
JWT_ISSUER=kmaedu-auth
JWT_AUDIENCE=kmaedu
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Service-to-service tokens (this service's own secret; auth only holds its hash under `ai-chat`).
AUTH_TOKEN_URL=http://localhost:3001/internal/token
SERVICE_CLIENT_SECRET=<printed-by-gen-service-secret>
