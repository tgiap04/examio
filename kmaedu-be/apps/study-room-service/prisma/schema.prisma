// study-room-service schema (database-per-service, phase 12). Postgres schema `studyroom`,
// role `studyroom_svc`. No relation or FK may point at a model owned by another service:
// `userId String` + `@@index` instead.
generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    engineType   = "client"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Idempotent-consumer ledger (libs/messaging). Both study-room handlers run with
// `dedupe: false` (DEL / disconnect are idempotent), so the table stays empty, but
// the consumer's db contract (`processedEvent`) requires it.
model ProcessedEvent {
    consumer    String
    eventId     String   @map("event_id")
    processedAt DateTime @default(now()) @map("processed_at")

    @@id([consumer, eventId])
    @@index([processedAt])
    @@map("processed_events")
}

// Study-Together Room: nhiều người học chung, Pomodoro + YouTube đồng bộ, roster + chat + leaderboard.
// Live state (timer/media/chat/presence) sống ở Redis; DB chỉ giữ cấu hình phòng + membership + focus tích luỹ.
// Playlist items + moderation/block state cũng ở DB (bền); playback (currentIndex/position) ở Redis.
model StudyRoom {
    id                    String   @id @default(cuid())
    name                  String
    description           String?
    hostId                String
    inviteCode            String   @unique // 6-digit
    accessType            Int      @default(0) // 0 PUBLIC(auth) | 1 CODE | 2 WHITELIST
    whitelist             String[] @default([]) // userId cho accessType=WHITELIST
    playlistAddPermission Int      @default(1) // 0 EVERYONE | 1 COHOST+ | 2 HOST
    workMinutes           Int      @default(30)
    breakMinutes          Int      @default(5)
    longBreakMinutes      Int      @default(15)
    cyclesBeforeLongBreak Int      @default(4)
    currentMediaUrl       String? // YouTube URL đang phát (nhạc hoặc video)
    isActive              Boolean  @default(true) // host đóng/mở phòng
    maxParticipants       Int      @default(20)
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt
    createdBy             String?
    updatedBy             String?

    members  StudyRoomMember[]
    playlist StudyRoomPlaylistItem[]

    @@index([hostId])
    @@index([inviteCode])
}

// Membership + role + thời gian tập trung tích luỹ. Một user một bản ghi mỗi phòng.
model StudyRoomMember {
    id                String   @id @default(cuid())
    studyRoomId       String
    userId            String
    role              Int      @default(0) // 0 MEMBER, 1 COHOST, 2 HOST
    totalFocusSeconds Int      @default(0)
    isBanned          Boolean  @default(false) // bị host/cohost cấm khỏi phòng
    isMuted           Boolean  @default(false) // bị cấm chat (cả phòng)
    joinedAt          DateTime @default(now())
    lastSeenAt        DateTime @default(now())

    studyRoom StudyRoom @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)

    @@unique([studyRoomId, userId])
    @@index([userId])
}

// Một mục trong playlist YouTube của phòng. kind=1 khi url là YT-playlist (chạy như 1 đơn vị).
model StudyRoomPlaylistItem {
    id            String   @id @default(cuid())
    studyRoomId   String
    url           String
    kind          Int      @default(0) // 0 VIDEO | 1 PLAYLIST
    title         String?
    addedByUserId String
    order         Int      @default(0)
    createdAt     DateTime @default(now())

    studyRoom StudyRoom @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)

    @@index([studyRoomId, order])
}

// Chặn chat cá nhân (chỉ ẩn với người chặn). Room-scoped, lưu server để đồng bộ đa thiết bị.
model StudyRoomChatBlock {
    id          String   @id @default(cuid())
    studyRoomId String
    blockerId   String // user thực hiện chặn
    blockedId   String // user bị chặn
    createdAt   DateTime @default(now())

    @@unique([studyRoomId, blockerId, blockedId])
    @@index([studyRoomId, blockerId])
}
