// assessment-service schema (database-per-service, phase 14). Postgres schema `assessment`, role
// `assessment_svc`. No relation or FK may point at a model owned by another service: `hostId` /
// `userId` are plain columns (auth) and `ExamRoom.quizSetId` names a content-service quiz set.
// The question content of a session lives in `ExamSession.quizSnapshot` (immutable once an attempt
// exists): nothing at exam time reads content-service.
generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    engineType   = "client"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Transactional outbox + idempotent-consumer ledger (libs/messaging).
model OutboxEvent {
    seq           BigInt    @id @default(autoincrement())
    id            String    @unique
    source        String
    type          String
    envelope      Json
    attempts      Int       @default(0)
    nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
    lockedUntil   DateTime? @map("locked_until")
    lastError     String?   @map("last_error")
    createdAt     DateTime  @default(now()) @map("created_at")
    publishedAt   DateTime? @map("published_at")

    // The relay's partial index (WHERE published_at IS NULL) lives only in the
    // migration SQL: Prisma cannot express it, and declaring a plain @@index here
    // makes `prisma migrate diff` report permanent drift against the partial one.
    @@map("outbox_events")
}

model ProcessedEvent {
    consumer    String
    eventId     String   @map("event_id")
    processedAt DateTime @default(now()) @map("processed_at")

    @@id([consumer, eventId])
    @@index([processedAt])
    @@map("processed_events")
}

model ExamRoom {
    id          String   @id @default(cuid())
    title       String
    description String?
    // content-service quiz set (no FK: another service owns it).
    quizSetId   String
    // Title of that set when the room was created / re-pointed: what student-facing views show (they
    // must never call content-service); teacher views refresh it from content through a cache.
    quizSetTitle String  @default("")
    // Set by `content.quizset.deleted`: no new session can be created, existing sessions keep their snapshot.
    sourceDeleted Boolean @default(false)
    hostId      String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now()) @updatedAt
    createdBy   String?
    updatedBy   String?

    examSessions ExamSession[]
    userPins     UserPinnedExamRoom[]

    @@index([hostId])
    @@index([quizSetId])
}

model ExamSession {
    id                     String    @id @default(cuid())
    examRoomId             String
    status                 Int       @default(0) // 0: UPCOMING, 1: ONGOING, 2: ENDED
    startTime              DateTime
    endTime                DateTime?
    timeLimitMinutes       Int? // Giới hạn thời gian (phút), null = không giới hạn
    autoJoinByLink         Boolean   @default(false)
    // Security and access control fields (moved from ExamRoom)
    assessType             Int       @default(0) // 0: PUBLIC, 1: PRIVATE
    allowRetake            Boolean   @default(false)
    maxAttempts            Int       @default(1)
    accessCode             String? // 6-digit code for private access
    whitelist              String[]  @default([]) // List of user IDs who can access
    codeGrantedIds         String[]  @default([]) // user ids that unlocked with the current code (cleared when the code changes)
    showAnswersAfterSubmit Boolean   @default(true) // Show detailed answers after submission
    passingScore           Float     @default(0) // Minimum score percentage to pass (0 = no minimum)

    // Question selection configuration
    // Immutable copy of the quiz set taken at creation (QuizSnapshotV1, zod-validated on read), and its
    // content hash (the cache key and the drift check). Only `refresh-snapshot` rewrites them, under a row lock.
    quizSnapshot           Json
    quizSnapshotHash       String

    questionCount          Int?      // Total number of questions for this session (null = all questions)
    questionSelectionMode  Int       @default(0) // 0: ALL, 1: RANDOM_TOTAL, 2: RANDOM_BY_LABEL
    labelQuestionConfig    Json?     // Array of { labelId: string, count: number } for RANDOM_BY_LABEL mode
    shuffleQuestions       Boolean   @default(false) // Shuffle question order for each attempt

    createdAt              DateTime  @default(now())
    updatedAt              DateTime  @default(now()) @updatedAt
    createdBy              String?
    updatedBy              String?

    examRoom     ExamRoom      @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
    examAttempts ExamAttempt[]

    @@index([accessCode])
    @@index([examRoomId])
}

model ExamAttempt {
    id             String    @id @default(cuid())
    examSessionId  String
    userId         String
    score          Float
    violationCount Int       @default(0)
    startedAt      DateTime
    finishedAt     DateTime?
    status         Int       @default(0) // 0: IN_PROGRESS, 1: COMPLETED, 2: CANCELLED

    // Answer tracking fields (similar to QuizPracticeAttempt)
    answers         Json     @default("{}") // { questionId: selectedAnswer }
    currentIndex    Int      @default(0) // Current question index
    markedQuestions String[] @default([]) // Marked question IDs
    totalQuestions  Int      @default(0)
    correctAnswers  Int      @default(0)

    // Selected questions for this attempt (stored to maintain consistency across attempts)
    selectedQuestionIds String[] @default([]) // Question IDs selected for this specific attempt

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    createdBy String?
    updatedBy String?

    examSession  ExamSession   @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
    cheatingLogs CheatingLog[]

    @@index([userId])
    @@index([examSessionId, userId])
}

// Cheating log for exam attempts - tracks violations per type
model CheatingLog {
    id             String   @id @default(cuid())
    examAttemptId  String
    type           String // TAB_SWITCH, WINDOW_BLUR, DEVTOOLS_OPEN, COPY_PASTE, RIGHT_CLICK, FULLSCREEN_EXIT, PRINT_SCREEN
    count          Int      @default(1)
    description    String? // Human-readable description
    lastOccurredAt DateTime @default(now())
    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now()) @updatedAt

    examAttempt ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)

    @@unique([examAttemptId, type]) // Upsert by type - O(1) lookup
    @@index([examAttemptId])
}

model UserPinnedExamRoom {
    id         String   @id @default(cuid())
    userId     String
    examRoomId String
    pinnedAt   DateTime @default(now())

    examRoom ExamRoom @relation(fields: [examRoomId], references: [id], onDelete: Cascade)

    @@unique([userId, examRoomId])
    @@index([userId, pinnedAt])
}
