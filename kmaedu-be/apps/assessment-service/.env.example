# Assessment Service Environment Variables

# Server
# Local dev only: services share one host, so ports are distinct. In containers
# every service listens on HTTP 3000 (see deploy/compose/assessment.yml). No gRPC server: assessment
# only calls other services.
PORT=3014
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# api | worker | api,worker
#   worker = outbox relay + daily purge (nothing is published yet)
ROLE=api,worker

# Database (role assessment_svc, schema assessment)
DATABASE_URL="postgresql://assessment_svc:password@localhost:5432/kmaedu?schema=assessment"

# Quiz Security (per-question JWT tokens of the secure quiz endpoints; the AES key of the crypto service)
QUIZ_JWT_SECRET=your_quiz_jwt_secret_32_chars_min
QUIZ_AES_KEY=your_aes_256_key_32_characters_
TURNSTILE_SECRET_KEY=

# Redis (every key starts with `assessment:`: repository caches, code-fail counters,
# title cache `assessment:cache:quizset:<id>`, profile cache `assessment:cache:user:<id>`)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ: broker user `assessment` (publishes ^assessment\. only; consumes assessment.events:
# content.quizset.deleted, auth.user.updated)
RABBITMQ_URL=

# gRPC clients
#   content-service GetQuizSetSnapshot / GetQuizSetsByIds / GetUserContentStats with the caller's forwarded
#     USER token only (teacher paths: session create/refresh, drift view, room create/list; the caller's
#     own token for the history stats). Never at exam time.
#   document-service GetQuota (history stats) with the forwarded user token
#   auth-service GetPublicProfilesByIds (profile enrichment) and SearchUsers (whitelist picker)
CONTENT_GRPC_URL=localhost:50057
DOCUMENT_GRPC_URL=localhost:50056
AUTH_GRPC_URL=localhost:50051

# Stateless auth (@kmaedu/auth-jwt): tokens are verified against auth's JWKS.
JWT_ISSUER=kmaedu-auth
JWT_AUDIENCE=kmaedu
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Service-to-service tokens (this service's own secret; auth only holds its hash under `assessment`).
AUTH_TOKEN_URL=http://localhost:3001/internal/token
SERVICE_CLIENT_SECRET=<printed-by-gen-service-secret>
