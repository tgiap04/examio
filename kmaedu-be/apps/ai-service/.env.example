# AI Service Environment Variables (Stateless)

# Server
PORT=3434

# Database (PostgreSQL for pgvector storage)
DATABASE_URL=postgresql://username:password@localhost:5432/kmaedu_db

# ============ GEMINI MULTI-KEY/MODEL ROTATION ============
# Danh sách 2 API keys phân cách bởi dấu phẩy - tự động xoay vòng khi hết quota
GEMINI_API_KEYS=key1,key2

# Danh sách models phân cách bởi dấu phẩy - tự động xoay vòng khi model fail
GEMINI_MODEL_NAMES=gemini-2.0-flash,gemini-1.5-flash

# ============ AI2 Content Generation (OpenAI-compatible) ============
# Used only for quiz/flashcard/content generation. Do not use AI2 for OCR embeddings.
AI2_BASE_URL=https://ai2.devt.vn/v1
AI2_API_KEY=
AI2_GENERATION_MODEL_NAMES=Faye-AI
AI2_DEFAULT_MODEL=Faye-AI
AI2_TIMEOUT_SECONDS=3600
AI2_MAX_TOKENS=4096

# Tutor/chat stream: keep prompt history small for faster first token.
CHAT_HISTORY_MAX_MESSAGES=4
CHAT_HISTORY_MAX_CHARS=1200

# ============ LLM Configuration - Gemini Embedding ============
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Model Settings
DEFAULT_MODEL_ID=Faye-AI
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096
DEFAULT_MAX_TOKENS_CAP=4096

# RabbitMQ (for async OCR processing)
RABBITMQ_URL=amqp://localhost:5672

# ============ Security ============
# gRPC callers authenticate with service tokens (see AUTH_JWKS_URL below); the HTTP
# listener serves only / and /health and holds no secret.

# Comma-separated list of hostnames allowed for outbound file downloads
# (R2/CDN SSRF allowlist). Takes precedence over R2_PUBLIC_URL below.
# Fails closed: if BOTH this and R2_PUBLIC_URL are unset, file downloads
# are refused entirely rather than allowing any public host.
R2_ALLOWED_HOSTS=

# Private-network stacks only (local S3 stub, self-hosted object store): set true to let a host that
# is listed in R2_ALLOWED_HOSTS (not the R2_PUBLIC_URL fallback) resolve to a private or loopback
# address (link-local is always refused). Default false: any such address is refused (SSRF hardening).
R2_ALLOW_PRIVATE_HOSTS=false

# Public/CDN base URL for stored files. Used as a fallback source for the
# download allowlist above when R2_ALLOWED_HOSTS is not set.
R2_PUBLIC_URL=

# Hard cap (bytes) on any single file downloaded from R2 before OCR/text
# extraction. Defaults to 50MB if unset.
MAX_DOWNLOAD_BYTES=52428800

# --- phase 15: gRPC, roles, own schema --------------------------------------------------------
# ROLE: api (gRPC + /health) | worker (events + outbox relay) | migrate (alembic upgrade head)
ROLE=api
GRPC_PORT=50058
# The service owns schema `ai`; there is no runtime DDL (tables come from Alembic).
DB_SEARCH_PATH=ai,extensions
# Service-token verification for gRPC (aud=ai, RS256 via the auth JWKS; auth listens on 3001 locally)
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=kmaedu-auth
