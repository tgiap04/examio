VITE_API_URL=/api/v1
VITE_BACKEND_URL=http://localhost:3000
VITE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID_HERE
# TEMPORARY: this key ships in the client bundle (client-side decryption is a
# stopgap — see security follow-up to move decryption server-side). Rotate it
# if it is ever suspected of leaking, and do not reuse it for anything else.
VITE_QUIZ_AES_KEY=YOUR_QUIZ_AES_KEY_HERE
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
