<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (HTTP) is allowed ONLY for local dev hosts so the emulator can reach
  the backend running on the host machine. Production hosts must use HTTPS.
  - 10.0.2.2   : host machine loopback as seen from the Android emulator
  - localhost  : on-device backend / adb reverse tunnels
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
