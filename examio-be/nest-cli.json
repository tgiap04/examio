{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "monorepo": true,
    "sourceRoot": "apps/exam-service/src",
    "entryFile": "main",
    "language": "ts",
    "generateOptions": {
        "spec": false
    },
    "compilerOptions": {
        "manualRestart": true,
        "tsConfigPath": "apps/exam-service/tsconfig.app.json",
        "webpack": true,
        "deleteOutDir": true,
        "assets": [
            {
                "include": "templates/**/*",
                "outDir": "dist",
                "watchAssets": true
            }
        ],
        "watchAssets": true,
        "plugins": []
    },
    "root": "apps/codecraft-be",
    "projects": {
        "ai-service": {
            "type": "application",
            "root": "apps/ai-service",
            "entryFile": "main",
            "sourceRoot": "apps/ai-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/ai-service/tsconfig.app.json"
            }
        },
        "auth-service": {
            "type": "application",
            "root": "apps/auth-service",
            "entryFile": "main",
            "sourceRoot": "apps/auth-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/auth-service/tsconfig.app.json",
                "assets": [
                    {
                        "include": "../../templates/**/*",
                        "outDir": "dist/apps/auth-service",
                        "watchAssets": true
                    },
                    {
                        "include": "../../../proto/examio/auth/**/*.proto",
                        "outDir": "dist/apps/auth-service/proto/examio/auth"
                    },
                    {
                        "include": "../../../proto/examio/common/**/*.proto",
                        "outDir": "dist/apps/auth-service/proto/examio/common"
                    },
                    {
                        "include": "../../../proto/examio/r2/**/*.proto",
                        "outDir": "dist/apps/auth-service/proto/examio/r2"
                    },
                    {
                        "include": "../../../proto/examio/gateway/**/*.proto",
                        "outDir": "dist/apps/auth-service/proto/examio/gateway"
                    }
                ]
            }
        },
        "common": {
            "type": "library",
            "root": "libs/common",
            "entryFile": "index",
            "sourceRoot": "libs/common/src",
            "compilerOptions": {
                "tsConfigPath": "libs/common/tsconfig.lib.json"
            }
        },
        "database": {
            "type": "library",
            "root": "libs/database",
            "entryFile": "index",
            "sourceRoot": "libs/database/src",
            "compilerOptions": {
                "tsConfigPath": "libs/database/tsconfig.lib.json"
            }
        },
        "exam-service": {
            "type": "application",
            "root": "apps/exam-service",
            "entryFile": "main",
            "sourceRoot": "apps/exam-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/exam-service/tsconfig.app.json",
                "assets": [
                    {
                        "include": "../../templates/**/*",
                        "outDir": "dist/apps/exam-service",
                        "watchAssets": true
                    },
                    {
                        "include": "../../../proto/examio/finance/**/*.proto",
                        "outDir": "dist/apps/exam-service/proto/examio/finance"
                    },
                    {
                        "include": "../../../proto/examio/r2/**/*.proto",
                        "outDir": "dist/apps/exam-service/proto/examio/r2"
                    }
                ]
            }
        },
        "finance-service": {
            "type": "application",
            "root": "apps/finance-service",
            "entryFile": "main",
            "sourceRoot": "apps/finance-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/finance-service/tsconfig.app.json",
                "assets": [
                    {
                        "include": "../../../proto/examio/finance/**/*.proto",
                        "outDir": "dist/apps/finance-service/proto/examio/finance"
                    }
                ]
            }
        },
        "admin-service": {
            "type": "application",
            "root": "apps/admin-service",
            "entryFile": "main",
            "sourceRoot": "apps/admin-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/admin-service/tsconfig.app.json",
                "assets": [
                    {
                        "include": "../../../proto/examio/auth/**/*.proto",
                        "outDir": "dist/apps/admin-service/proto/examio/auth"
                    },
                    {
                        "include": "../../../proto/examio/common/**/*.proto",
                        "outDir": "dist/apps/admin-service/proto/examio/common"
                    }
                ]
            }
        },
        "r2-service": {
            "type": "application",
            "root": "apps/r2-service",
            "entryFile": "main",
            "sourceRoot": "apps/r2-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/r2-service/tsconfig.app.json",
                "assets": [
                    {
                        "include": "../../../proto/examio/r2/**/*.proto",
                        "outDir": "dist/apps/r2-service/proto/examio/r2"
                    }
                ]
            }
        },
        "gateway-service": {
            "type": "application",
            "root": "apps/gateway-service",
            "entryFile": "main",
            "sourceRoot": "apps/gateway-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/gateway-service/tsconfig.app.json",
                "assets": [
                    {
                        "include": "../config/*.yaml",
                        "outDir": "dist/apps/gateway-service/config"
                    },
                    {
                        "include": "pipeline/*.lua",
                        "outDir": "dist/apps/gateway-service"
                    },
                    {
                        "include": "../../../proto/examio/gateway/**/*.proto",
                        "outDir": "dist/apps/gateway-service/proto/examio/gateway"
                    }
                ]
            }
        },
        "observability": {
            "type": "library",
            "root": "libs/observability",
            "entryFile": "index",
            "sourceRoot": "libs/observability/src",
            "compilerOptions": {
                "tsConfigPath": "libs/observability/tsconfig.lib.json"
            }
        },
        "redis": {
            "type": "library",
            "root": "libs/redis",
            "entryFile": "index",
            "sourceRoot": "libs/redis/src",
            "compilerOptions": {
                "tsConfigPath": "libs/redis/tsconfig.lib.json"
            }
        },
        "contracts": {
            "type": "library",
            "root": "libs/contracts",
            "entryFile": "index",
            "sourceRoot": "libs/contracts/src",
            "compilerOptions": {
                "tsConfigPath": "libs/contracts/tsconfig.lib.json"
            }
        },
        "grpc": {
            "type": "library",
            "root": "libs/grpc",
            "entryFile": "index",
            "sourceRoot": "libs/grpc/src",
            "compilerOptions": {
                "tsConfigPath": "libs/grpc/tsconfig.lib.json"
            }
        },
        "http": {
            "type": "library",
            "root": "libs/http",
            "entryFile": "index",
            "sourceRoot": "libs/http/src",
            "compilerOptions": {
                "tsConfigPath": "libs/http/tsconfig.lib.json"
            }
        }
    }
}
