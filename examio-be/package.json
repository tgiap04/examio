{
    "name": "codecraft-be",
    "version": "1.0.0",
    "description": "",
    "main": "dist/src/main",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "proto:lint": "buf lint proto",
        "proto:gen": "cd proto && buf generate",
        "gen:fe-permissions": "ts-node scripts/gen-fe-permissions.ts",
        "typecheck:auth": "tsc --noEmit -p apps/auth-service/tsconfig.app.json",
        "typecheck:exam": "tsc --noEmit -p apps/exam-service/tsconfig.app.json",
        "typecheck:finance": "tsc --noEmit -p apps/finance-service/tsconfig.app.json",
        "typecheck:admin": "tsc --noEmit -p apps/admin-service/tsconfig.app.json",
        "typecheck:r2": "tsc --noEmit -p apps/r2-service/tsconfig.app.json",
        "typecheck:gateway": "tsc --noEmit -p apps/gateway-service/tsconfig.app.json",
        "typecheck": "yarn typecheck:auth && yarn typecheck:exam && yarn typecheck:finance && yarn typecheck:admin && yarn typecheck:r2 && yarn typecheck:gateway",
        "build:all": "yarn proto:gen && nest build auth-service && nest build exam-service && nest build finance-service && nest build admin-service && nest build r2-service && nest build gateway-service",
        "check:ownership": "ts-node scripts/check-model-ownership.ts --strict",
        "check:deps": "depcruise apps libs --config .dependency-cruiser.cjs",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "dev:auth": "nest start auth-service --watch",
        "dev:exam": "nest start exam-service --watch",
        "dev:finance": "nest start finance-service --watch",
        "dev:admin": "nest start admin-service --watch",
        "dev:r2": "nest start r2-service --watch",
        "dev:gateway": "nest start gateway-service --watch",
        "dev:ai": "cd apps/ai-service && PYTHONPATH=src SSL_CERT_FILE=$(./venv/bin/python -c 'import certifi; print(certifi.where())') ./venv/bin/uvicorn src.backend.main:app --reload --port 8000",
        "dev:all": "concurrently \"yarn dev:gateway\" \"yarn dev:auth\" \"yarn dev:exam\" \"yarn dev:finance\" \"yarn dev:admin\" \"yarn dev:r2\" \"yarn dev:ai\"",
        "prisma:generate": "scripts/prisma-generate.sh",
        "prisma:migrate": "scripts/prisma-migrate-dev.sh",
        "prisma:deploy": "bash -c 'node_modules/.bin/prisma migrate deploy --schema \"$(scripts/prisma-schema-path.sh \"$0\")\"'",
        "prisma:status": "bash -c 'node_modules/.bin/prisma migrate status --schema \"$(scripts/prisma-schema-path.sh \"$0\")\"'",
        "prisma:seed": "yarn seed:admin && yarn seed:exam",
        "seed:admin": "ts-node --transpile-only apps/admin-service/prisma/seed.ts",
        "seed:exam": "ts-node --transpile-only apps/exam-service/prisma/seed.ts",
        "seed:dev:auth": "ts-node --transpile-only apps/auth-service/prisma/seed.ts --dev",
        "seed:dev:finance": "ts-node --transpile-only apps/finance-service/prisma/seed.ts --dev",
        "seed:dev:admin": "ts-node --transpile-only apps/admin-service/prisma/seed.ts --dev",
        "seed:dev:exam": "ts-node --transpile-only apps/exam-service/prisma/seed.ts --dev",
        "seed:dev": "yarn seed:dev:auth && yarn seed:dev:finance && yarn seed:dev:admin && yarn seed:dev:exam",
        "start:prod": "node dist/apps/codecraft-be/main",
        "bootstrap:admin": "ts-node -r tsconfig-paths/register apps/auth-service/src/commands/cli.ts sync",
        "bootstrap:admin:list": "ts-node -r tsconfig-paths/register apps/auth-service/src/commands/cli.ts list",
        "bootstrap:admin:grant": "ts-node -r tsconfig-paths/register apps/auth-service/src/commands/cli.ts grant",
        "bootstrap:admin:revoke": "ts-node -r tsconfig-paths/register apps/auth-service/src/commands/cli.ts revoke",
        "finance:reconcile-teachers": "ts-node -r tsconfig-paths/register apps/finance-service/src/commands/cli.ts reconcile-teachers"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "yarn@4.9.2",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.896.0",
        "@aws-sdk/s3-request-presigner": "^3.1084.0",
        "@google/genai": "^1.19.0",
        "@grpc/grpc-js": "^1.14.4",
        "@grpc/proto-loader": "^0.8.0",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/common": "^11.1.3",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.3",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/microservices": "^11.1.10",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.3",
        "@nestjs/platform-socket.io": "^11",
        "@nestjs/swagger": "^11.2.0",
        "@nestjs/terminus": "11.1.1",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^11",
        "@prisma/adapter-pg": "6.19.3",
        "@prisma/client": "6.19.3",
        "@socket.io/redis-adapter": "^8.3.0",
        "@techstark/opencv-js": "4.12.0-release.1",
        "amqp-connection-manager": "^5.0.0",
        "amqplib": "^0.10.9",
        "axios": "^1.17.0",
        "bcryptjs": "^3.0.2",
        "cookie": "^1.0.2",
        "cookie-parser": "^1.4.7",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.3",
        "ejs": "^3.1.10",
        "express": "^5.1.0",
        "form-data": "^4.0.6",
        "google-auth-library": "^9.14.0",
        "helmet": "^8.2.0",
        "http-proxy-middleware": "3.0.7",
        "ioredis": "^5.8.2",
        "jimp": "^1.6.0",
        "jose": "5.10.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.2.0",
        "nestjs-pino": "5.3.1",
        "nestjs-zod": "^4.3.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^9.0.3",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "pdf-lib": "^1.17.1",
        "pdf-parse-new": "1.3.3",
        "pdf2pic": "^3.2.0",
        "pg": "^8.16.3",
        "pino": "10.4.0",
        "pino-http": "11.0.0",
        "prisma": "6.19.3",
        "proxy-addr": "^2.0.8",
        "reflect-metadata": "~0.2.2",
        "rxjs": "^7.8.2",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1",
        "tesseract.js": "5.0.1",
        "ulid": "3.0.2",
        "yaml": "^2.9.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@bufbuild/buf": "1.74.0",
        "@nestjs/cli": "^11.0.7",
        "@nestjs/schematics": "^11.0.5",
        "@nestjs/testing": "^11.1.11",
        "@types/cookie-parser": "^1.4.10",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.0.13",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^6.4.17",
        "@types/passport-google-oauth20": "^2.0.16",
        "@types/pg": "^8.15.5",
        "@types/proxy-addr": "^2",
        "@types/supertest": "^6.0.3",
        "@types/ws": "^8.18.2",
        "concurrently": "^9.2.1",
        "dependency-cruiser": "^16",
        "jest": "^30.2.0",
        "prettier": "^3.6.2",
        "socket.io-client": "^4.8",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.4",
        "ts-node": "10.9.2",
        "ts-proto": "2.15.3",
        "typescript": "^5.8.3",
        "ws": "^8.22.0"
    }
}
