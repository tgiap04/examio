{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "setupFiles": ["<rootDir>/../../../test/jest-env.setup.js"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@examio/auth-jwt(.*)$": "<rootDir>/../src/$1",
    "^@examio/messaging(.*)$": "<rootDir>/../src/$1"
  },
  "testTimeout": 60000,
  "forceExit": true
}
