// Study-Together Room: nhiều người học chung, Pomodoro + YouTube đồng bộ, roster + chat + leaderboard.
// Live state (timer/media/chat/presence) sống ở Redis; DB chỉ giữ cấu hình phòng + membership + focus tích luỹ.
// Playlist items + moderation/block state cũng ở DB (bền); playback (currentIndex/position) ở Redis.
model StudyRoom {
    id                    String   @id @default(cuid())
    name                  String
    description           String?
    hostId                String
    inviteCode            String   @unique // 6-digit
    accessType            Int      @default(0) // 0 PUBLIC(auth) | 1 CODE | 2 WHITELIST
    whitelist             String[] @default([]) // userId cho accessType=WHITELIST
    playlistAddPermission Int      @default(1) // 0 EVERYONE | 1 COHOST+ | 2 HOST
    workMinutes           Int      @default(30)
    breakMinutes          Int      @default(5)
    longBreakMinutes      Int      @default(15)
    cyclesBeforeLongBreak Int      @default(4)
    currentMediaUrl       String? // YouTube URL đang phát (nhạc hoặc video)
    isActive              Boolean  @default(true) // host đóng/mở phòng
    maxParticipants       Int      @default(20)
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt
    createdBy             String?
    updatedBy             String?

    host     User                    @relation(fields: [hostId], references: [id], onDelete: Cascade)
    members  StudyRoomMember[]
    playlist StudyRoomPlaylistItem[]

    @@index([hostId])
    @@index([inviteCode])
}

// Membership + role + thời gian tập trung tích luỹ. Một user một bản ghi mỗi phòng.
model StudyRoomMember {
    id                String   @id @default(cuid())
    studyRoomId       String
    userId            String
    role              Int      @default(0) // 0 MEMBER, 1 COHOST, 2 HOST
    totalFocusSeconds Int      @default(0)
    isBanned          Boolean  @default(false) // bị host/cohost cấm khỏi phòng
    isMuted           Boolean  @default(false) // bị cấm chat (cả phòng)
    joinedAt          DateTime @default(now())
    lastSeenAt        DateTime @default(now())

    studyRoom StudyRoom @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([studyRoomId, userId])
    @@index([userId])
}

// Một mục trong playlist YouTube của phòng. kind=1 khi url là YT-playlist (chạy như 1 đơn vị).
model StudyRoomPlaylistItem {
    id            String   @id @default(cuid())
    studyRoomId   String
    url           String
    kind          Int      @default(0) // 0 VIDEO | 1 PLAYLIST
    title         String?
    addedByUserId String
    order         Int      @default(0)
    createdAt     DateTime @default(now())

    studyRoom StudyRoom @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)

    @@index([studyRoomId, order])
}

// Chặn chat cá nhân (chỉ ẩn với người chặn). Room-scoped, lưu server để đồng bộ đa thiết bị.
model StudyRoomChatBlock {
    id          String   @id @default(cuid())
    studyRoomId String
    blockerId   String // user thực hiện chặn
    blockedId   String // user bị chặn
    createdAt   DateTime @default(now())

    @@unique([studyRoomId, blockerId, blockedId])
    @@index([studyRoomId, blockerId])
}


// Subject Category - Nhóm môn học (VD: Toán học, Khoa học Tự nhiên, ...)
model SubjectCategory {
    id          String   @id @default(cuid())
    name        String   @unique // Tên nhóm (VD: "Toán học", "Khoa học Tự nhiên")
    slug        String   @unique // URL-friendly slug
    description String?
    icon        String? // Icon/emoji cho nhóm
    color       String? // Màu sắc đại diện (hex)
    order       Int      @default(0) // Thứ tự hiển thị
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now()) @updatedAt

    subjects Subject[]

    @@index([isActive, order])
}

// Subject - Giáo viên AI (mỗi môn học = 1 giáo viên)
model Subject {
    id           String   @id @default(cuid())
    categoryId   String
    name         String   @unique // Tên môn (VD: "Toán Tiểu học", "Vật lý")
    slug         String   @unique // URL-friendly slug
    description  String? // Mô tả ngắn về môn học
    icon         String? // Icon/emoji đại diện
    color        String? // Màu sắc đại diện (hex)
    systemPrompt String   @db.Text // System prompt cho LLM (bắt buộc)
    order        Int      @default(0) // Thứ tự hiển thị trong category
    isActive     Boolean  @default(true) // Trạng thái hoạt động
    createdAt    DateTime @default(now())
    updatedAt    DateTime @default(now()) @updatedAt

    category SubjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    aiChats  AIChat[]

    @@index([categoryId, isActive, order])
    @@index([isActive, order])
}


model User {
    id         String   @unique
    email      String   @unique
    username   String   @unique
    name       String?
    avatar     String?
    banner     String?
    bio        String?
    isAdmin    Boolean  @default(false)
    isVerified Boolean  @default(false)
    isBanned   Boolean  @default(false)
    deletedAt  DateTime?
    password   String?
    utmSource  String?  @db.VarChar(64) // nguồn first-touch lúc đăng ký (utm_source); null = direct
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
    createdBy  String?
    updatedBy  String?

    verifyAccountCode         VerifyAccountCode?
    resetPasswordCode         ResetPasswordCode?
    userStorage               UserStorage[]
    wallet                    Wallet?
    payments                  Payment[]
    quizSets                  QuizSet[]
    flashCardSets             FlashCardSet[]
    examRooms                 ExamRoom[]
    examAttempts              ExamAttempt[]
    historyGeneratedQuizz     HistoryGeneratedQuizz[]
    historyGeneratedFlashcard HistoryGeneratedFlashcard[]
    quizPracticeAttempts      QuizPracticeAttempt[]
    aiChats                   AIChat[]
    subscription              UserSubscription?
    sessions                  UserSession[]
    monthlyFileUploads        UserMonthlyFileUpload[]
    flashCardViewHistories    FlashCardViewHistory[]
    pinnedFlashcards          UserPinnedFlashcard[]
    pinnedExamRooms           UserPinnedExamRoom[]
    flashcardStudyProgress    FlashcardStudyProgress[]
    adminAudits               AdminAudit[]
    savedWordFamilies         UserSavedWordFamily[]
    hostedStudyRooms          StudyRoom[]
    studyRoomMemberships      StudyRoomMember[]

    @@index([utmSource])
}

// Subscription tiers: 0=none, 1=basic, 2=advanced, 3=vip
model UserSubscription {
    id              String    @unique
    userId          String    @unique
    tier            Int       @default(0) // 0=none, 1=basic, 2=advanced, 3=vip
    billingCycle    String    @default("monthly") // monthly | yearly
    lastPaymentDate DateTime?
    nextPaymentDate DateTime?
    isActive        Boolean   @default(false)
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    createdBy       String?
    updatedBy       String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerifyAccountCode {
    id        String   @unique
    userId    String   @unique
    code      String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResetPasswordCode {
    id        String   @unique
    userId    String   @unique
    code      String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Track monthly file uploads for subscription limits
model UserMonthlyFileUpload {
    id        String   @id @default(cuid())
    userId    String
    yearMonth String // Format: "2024-12" for efficient monthly grouping
    count     Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, yearMonth])
    @@index([userId, yearMonth])
}


model UserSession {
    id            String   @id
    userId        String
    sessionId     String   @unique
    refreshToken  String   @unique // Token để refresh access token
    // Token cũ ngay trước lần rotate gần nhất, còn dùng được trong grace window
    // để tránh tự đăng xuất khi nhiều tab/nhiều request refresh song song.
    previousRefreshToken   String?   @unique
    previousTokenExpiresAt DateTime?
    deviceId      String
    deviceName    String?
    browser       String?
    os            String?
    ipAddress     String?
    country       String?
    city          String?
    isActive      Boolean  @default(true)
    lastActivity  DateTime @default(now())
    createdAt     DateTime @default(now())
    expiresAt     DateTime
    updatedAt     DateTime @default(now()) @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, isActive])
    @@index([userId, deviceId])
    @@index([refreshToken])
    @@index([previousRefreshToken])
}


// Word Family Category — seeded by admin, used to organize root words
model WordFamilyCategory {
    id          String   @id @default(cuid())
    name        String   @unique
    slug        String   @unique
    description String?
    imageUrl    String?
    order       Int      @default(0)
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    wordFamilies WordFamily[]

    @@index([isActive, order])
}

// Word Family — AI-generated cache of word variants for a root word in a category
model WordFamily {
    id           String   @id @default(cuid())
    rootWord     String
    categoryId   String
    categorySlug String
    data         Json
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    category WordFamilyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    savedByUsers UserSavedWordFamily[]

    @@unique([rootWord, categorySlug])
    @@index([categorySlug])
    @@index([categoryId])
    @@index([rootWord])
}

// User's saved word families — reference-based, O(1) lookup
model UserSavedWordFamily {
    id           String   @id @default(cuid())
    userId       String
    wordFamilyId String
    savedAt      DateTime @default(now())

    user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    wordFamily WordFamily @relation(fields: [wordFamilyId], references: [id], onDelete: Cascade)

    @@unique([userId, wordFamilyId])
    @@index([userId])
    @@index([wordFamilyId])
}