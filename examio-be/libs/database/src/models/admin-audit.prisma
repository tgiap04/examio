model AdminAudit {
    id        String   @id @default(cuid())
    adminId   String
    action    String
    targetId  String?
    payload   Json?
    reason    String?
    ipAddress String?
    userAgent String?
    createdAt DateTime @default(now())

    admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

    @@index([adminId, createdAt(sort: Desc)])
    @@index([action, createdAt(sort: Desc)])
}
