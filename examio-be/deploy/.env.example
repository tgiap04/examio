# deploy/.env - compose-level variables ONLY (never commit the real one).
#
# Compose reads this file to interpolate ${VAR} in deploy/compose/*.yml. It is NOT passed to the
# containers: each service gets its own runtime variables from deploy/env/<name>.env (see
# deploy/env/*.env.example and deploy/env/README.md). Secrets that exactly one service reads
# (PAYMENT_*, GOOGLE_*, EMAIL_*, R2 keys, GEMINI_*, QUIZ_*, TURNSTILE_*, ADMIN_*) live there, so a
# compromised container only sees its own.
#
# What stays here is what compose itself, postgres init and rabbitmq-defs need, or what is
# interpolated into several services. Image tags are NOT here: deploy-service.sh pins them in the
# gitignored deploy/.tags.env (<KEY>_TAG=<sha>, default :main).

FRONTEND_URL=https://your-frontend-domain.com

# PostgreSQL container. The superuser is used ONLY by the image to run deploy/postgres/init/01-service-schemas.sh
# (ops/break-glass access); no service connects with it.
POSTGRES_USER=examio
POSTGRES_PASSWORD=
POSTGRES_DB=examio

# Database per service: one role <svc>_svc + schema <svc> each, created by the init script on an EMPTY
# data volume. Compose builds every service's DATABASE_URL as
#   postgresql://<svc>_svc:<password>@postgres:5432/${POSTGRES_DB}?schema=<svc>
# Passwords go into URLs: use URL-safe characters (`openssl rand -hex 24`). All ten are required.
AUTH_DB_PASSWORD=
FINANCE_DB_PASSWORD=
ADMIN_DB_PASSWORD=
STUDYROOM_DB_PASSWORD=
VOCABULARY_DB_PASSWORD=
CONTENT_DB_PASSWORD=
ASSESSMENT_DB_PASSWORD=
AICHAT_DB_PASSWORD=
DOCUMENT_DB_PASSWORD=
AI_DB_PASSWORD=

REDIS_PASSWORD=

# RabbitMQ: ops/admin user (management UI only) and one broker user per service (publish only its own
# routing-key prefix). deploy/rabbitmq/definitions.json is rendered from these (never committed).
# URL-safe passwords (`openssl rand -hex 24`): each is embedded in that service's amqp:// URL.
RABBITMQ_USER=examio
RABBITMQ_PASS=
RABBITMQ_AUTH_PASS=
RABBITMQ_FINANCE_PASS=
RABBITMQ_CONTENT_PASS=
RABBITMQ_ASSESSMENT_PASS=
RABBITMQ_STUDYROOM_PASS=
RABBITMQ_DOCUMENT_PASS=
RABBITMQ_AI_PASS=
RABBITMQ_GATEWAY_PASS=
RABBITMQ_AICHAT_PASS=

# JWT (auth signs; every other service only verifies through the auth JWKS). scripts/gen-jwt-keypair.sh
JWT_PRIVATE_KEY=
JWT_KID=
JWT_RETIRED_PUBLIC_KEYS=
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio

# Service tokens (service-to-service gRPC). scripts/gen-service-secret.sh <name> prints a secret and its
# hash: the caller gets the secret below, auth gets every hash in SERVICE_CLIENTS (JSON {"<name>":"<sha256>"}).
SERVICE_CLIENTS=
CONTENT_SERVICE_CLIENT_SECRET=
ASSESSMENT_SERVICE_CLIENT_SECRET=
STUDYROOM_SERVICE_CLIENT_SECRET=
VOCABULARY_SERVICE_CLIENT_SECRET=
DOCUMENT_SERVICE_CLIENT_SECRET=
AICHAT_SERVICE_CLIENT_SECRET=
FINANCE_SERVICE_CLIENT_SECRET=
ADMIN_SERVICE_CLIENT_SECRET=
GATEWAY_SERVICE_CLIENT_SECRET=

# Public R2 base URL and the hosts ai-service may download presigned URLs from (SSRF allow-list; the host of
# R2_ENDPOINT). Several services need R2_PUBLIC_URL to tell their own objects from external URLs.
R2_PUBLIC_URL=https://your-r2-public-domain.com
R2_ALLOWED_HOSTS=your_account_id.r2.cloudflarestorage.com

# Optional shared tunables (defaults live in the compose files).
# GATEWAY_CONTROL_ENABLED=true
# GENERATION_JOB_TIMEOUT_MINUTES=60
# AI_CHAT_DOCUMENT_WAIT_MS=120000
# Free AI generation for local use; ignored when NODE_ENV=production.
# AI_FREE_MODE=false
# AI2_BASE_URL=
# AI2_GENERATION_MODEL_NAMES=
# AI2_DEFAULT_MODEL=
# AI2_TIMEOUT_SECONDS=3600
# AI2_MAX_TOKENS=4096
# DEFAULT_MAX_TOKENS_CAP=4096
# TUTOR_FAST_RETRIEVAL_TIMEOUT_SECONDS=0.5
# CHAT_HISTORY_MAX_MESSAGES=4
# CHAT_HISTORY_MAX_CHARS=1200
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004
