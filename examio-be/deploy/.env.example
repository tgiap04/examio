# Core
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-frontend-domain.com

# Security
INTERNAL_SERVICE_TOKEN=your_internal_service_token
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRATION=7d
# Encrypts refresh tokens at rest (AES-256). Min 32 chars, distinct per env.
REFRESH_TOKEN_ENC_KEY=your_refresh_token_enc_key_min_32_chars
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Quiz Security (Exam Service)
QUIZ_JWT_SECRET=your_quiz_jwt_secret
QUIZ_AES_KEY=your_quiz_aes_key_32_chars

# PostgreSQL Container Configuration
POSTGRES_USER=examio
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=examio_db

# Database (PostgreSQL) - Docker Container
# The DATABASE_URL should use 'postgres' as the hostname (Docker service name)
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://examio:your_postgres_password@postgres:5432/examio_db

# Redis - External
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# RabbitMQ (Message Queue)
# Ops/admin user (management UI only; no application connects with it).
RABBITMQ_USER=examio
RABBITMQ_PASS=your_rabbitmq_admin_password
# One broker user per service (topic permissions: publish only its own
# routing-key prefix). Each service gets RABBITMQ_URL built from its password
# in docker-compose.yml. Use URL-safe passwords (e.g. `openssl rand -hex 24`).
# deploy/rabbitmq/definitions.json is rendered from these (never committed).
RABBITMQ_AUTH_PASS=your_rabbitmq_auth_password
RABBITMQ_FINANCE_PASS=your_rabbitmq_finance_password
RABBITMQ_EXAM_PASS=your_rabbitmq_exam_password
RABBITMQ_AI_PASS=your_rabbitmq_ai_password
RABBITMQ_GATEWAY_PASS=your_rabbitmq_gateway_password

# ============ AI Service Configuration ============
GEMINI_API_KEYS=key1,key2
GEMINI_MODEL_NAMES=gemini-2.0-flash,gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=your_openai_api_key

RAG_MODEL=gemini

# AI Settings
DEFAULT_MODEL_TYPE=Faye-AI
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096

# ============ R2 Storage (Cloudflare) ============
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket
R2_ACCOUNT_ID=your_r2_account_id
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your-r2-public-domain.com

# ============ Payment (SePay) ============
PAYMENT_SERVICE_SEPAY_KEY=your_sepay_key
PAYMENT_BASE_URL=https://your-payment-base-url.com
PAYMENT_QR_BANK_ACCOUNT=your_bank_account
PAYMENT_QR_BANK_CODE=your_bank_code
PAYMENT_WEBHOOK_SECRET_KEY=your_payment_webhook_secret

# Mail configuration
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password

# Google authentication
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/callback

# Facebook authentication
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_CALLBACK_URL=https://your-domain.com/api/v1/auth/facebook/callback

# Github authentication
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-domain.com/api/v1/auth/github/callback

# ============ Service URLs (Internal Docker Network) ============
# Do not change these unless you rename services in docker-compose
AUTH_SERVICE_URL=http://auth:3000
EXAM_SERVICE_URL=http://exam:3000
FINANCE_SERVICE_URL=http://finance:3000
AI_SERVICE_URL=http://ai:3000/api
GATEWAY_URL=http://gateway:3000
ADMIN_SERVICE_URL=http://admin:3000

# gRPC Configuration (Internal)
AUTH_GRPC_URL=auth:50051
R2_GRPC_URL=r2:50051
FINANCE_GRPC_URL=finance:50051

# ============ AI2 Content Generation (OpenAI-compatible) ============
# Used only for quiz/flashcard/content generation. Do not use AI2 for OCR embeddings.
AI2_BASE_URL=https://your-ai2-endpoint.com/v1
AI2_API_KEY=your_ai2_api_key
AI2_GENERATION_MODEL_NAMES=Faye-AI
AI2_DEFAULT_MODEL=Faye-AI
AI2_TIMEOUT_SECONDS=3600
AI2_MAX_TOKENS=4096

# AI streaming performance limits
DEFAULT_MAX_TOKENS_CAP=4096
TUTOR_FAST_RETRIEVAL_TIMEOUT_SECONDS=0.5
CHAT_HISTORY_MAX_MESSAGES=4
CHAT_HISTORY_MAX_CHARS=1200
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ============ Cloudflare Turnstile (Bot Protection) ============
TURNSTILE_SECRET_KEY=your_turnstile_secret_key


ADMIN_EMAILS=admin@example.com
# Default password for NEW admin users created by bootstrap (min 16 chars)
ADMIN_DEFAULT_PASSWORD=your_admin_default_password
# Log directory inside container
LOGS_DIR=/app/logs
# Rate limit: requests per minute per admin
THROTTLE_ADMIN_LIMIT=100
