# Prisma Migration Runner - Minimal image
# Strategy: `prisma migrate deploy` applies the committed migration files (baseline first).
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare yarn@4.9.2 --activate
WORKDIR /app

COPY package.json yarn.lock .yarnrc.yml ./
COPY libs ./libs

RUN yarn install --immutable && \
    yarn prisma:merge && \
    yarn prisma:generate && \
    rm -rf /root/.cache /tmp/*

COPY deploy/entrypoint-migration.sh ./entrypoint-migration.sh
RUN chmod +x ./entrypoint-migration.sh

CMD ["./entrypoint-migration.sh"]
