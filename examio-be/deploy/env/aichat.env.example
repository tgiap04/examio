# aichat (ai-chat-service) - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Shared by every service container (compose sets these inline)
NODE_ENV=production
PORT=3000
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json

# CORS allowlist for the browser origin
FRONTEND_URL=

# Database: own role + schema only (created by deploy/postgres/init/01-service-schemas.sh).
# Password must be URL-safe (it is embedded in the URL): openssl rand -hex 24
AICHAT_DB_PASSWORD=
# Built by compose from the password above; shown for reference, do not set.
# DATABASE_URL=postgresql://aichat_svc:<AICHAT_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=aichat

# Cache of the subscription benefits (keys under prefix aichat:benefits:, 5 minutes)
REDIS_HOST=redis
REDIS_PASSWORD=
# Broker user `aichat`: consumes aichat.events (document.deleted, finance.subscription.changed), publishes nothing.
RABBITMQ_AICHAT_PASS=
# api + the r2_delete_tasks worker (message images) in one container
ROLE=api,worker
# AiService Query/StreamChat as svc:ai-chat; DocumentService and finance GetUserBenefits as the caller
# (forwarded user token); r2 DeleteObjects as svc:ai-chat
AI_GRPC_URL=ai:50051
DOCUMENT_GRPC_URL=document:50051
FINANCE_GRPC_URL=finance:50051
R2_GRPC_URL=r2:50051
# Public base of R2 objects (tells an R2-hosted message image from an external URL; unset => none is deleted)
R2_PUBLIC_URL=
# How long one message waits for its documents' OCR (ms, 0 = do not wait). On timeout the message
# goes on without that document's context. Default 120000.
AI_CHAT_DOCUMENT_WAIT_MS=120000
# Service token (as svc:ai-chat; auth holds only the hash, under the client name `ai-chat`)
AUTH_TOKEN_URL=http://auth:3000/internal/token
AICHAT_SERVICE_CLIENT_SECRET=
