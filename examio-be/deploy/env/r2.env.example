# r2 - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Shared by every service container (compose sets these inline)
NODE_ENV=production
PORT=3000
GRPC_PORT=50051
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json

# No database. Cloudflare R2 credentials only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_PUBLIC_URL=
