# r2-service - deploy/env/r2.env (copy from this file; never commit the real one).
# Only what r2-service reads at runtime and compose does NOT set. Compose already sets the wiring
# (ports, DATABASE_URL, REDIS_*, RABBITMQ_URL, *_GRPC_URL, JWT_*, SERVICE_CLIENT_SECRET) from deploy/.env.
# Empty KEY= lines are required values; commented lines are optional tunables with their default.

# Cloudflare R2 credentials. No database; ports, gRPC and JWKS are wired by compose.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL of the bucket (custom domain).
R2_PUBLIC_URL=

# Optional.
# Prefixes served only through presigned URLs.
# R2_PRIVATE_PREFIXES=ai-uploads,ai-teacher,documents
