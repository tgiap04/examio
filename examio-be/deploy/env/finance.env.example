# finance-service - deploy/env/finance.env (copy from this file; never commit the real one).
# Only what finance-service reads at runtime and compose does NOT set. Compose already sets the wiring
# (ports, DATABASE_URL, REDIS_*, RABBITMQ_URL, *_GRPC_URL, JWT_*, SERVICE_CLIENT_SECRET) from deploy/.env.
# Empty KEY= lines are required values; commented lines are optional tunables with their default.

# SePay payment gateway.
PAYMENT_SERVICE_SEPAY_KEY=
PAYMENT_WEBHOOK_SECRET_KEY=
PAYMENT_QR_BANK_ACCOUNT=
PAYMENT_QR_BANK_CODE=

# Optional.
# SePay API base URL.
# PAYMENT_BASE_URL=https://my.sepay.vn
# Worker: flips lapsed subscriptions to tier 0 and publishes finance.subscription.changed (ms).
# SUBSCRIPTION_EXPIRY_SWEEP_MS=60000
