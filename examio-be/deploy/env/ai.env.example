# ai-service (api + worker) - deploy/env/ai.env (copy from this file; never commit the real one).
# Only what ai-service (api + worker) reads at runtime and compose does NOT set. Compose already sets the wiring
# (ports, DATABASE_URL, REDIS_*, RABBITMQ_URL, *_GRPC_URL, JWT_*, SERVICE_CLIENT_SECRET) from deploy/.env.
# Empty KEY= lines are required values; commented lines are optional tunables with their default.

# Gemini keys (comma list) and model names. One image, ROLE selects ai-migrate | ai | ai-worker (compose/ai.yml).
GEMINI_API_KEYS=
GEMINI_MODEL_NAMES=
# Key for the OpenAI-compatible generation endpoint (AI2_BASE_URL is set by compose, default in compose/ai.yml).
AI2_API_KEY=

# Optional.
# Private-network object store only: true lets a host listed in R2_ALLOWED_HOSTS resolve to a private
# or loopback address (link-local, e.g. 169.254.169.254, is always refused).
# R2_ALLOW_PRIVATE_HOSTS=false
# R2_ALLOWED_HOSTS / R2_PUBLIC_URL (worker) are set by compose from deploy/.env.
