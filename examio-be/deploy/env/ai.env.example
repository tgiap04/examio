# ai - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Python ai-service: one image, ROLE selects ai-migrate | ai (api) | ai-worker (see deploy/compose/ai.yml).
PYTHONUNBUFFERED=1
PORT=3000          # FastAPI /health only (no business HTTP route)
GRPC_PORT=50051    # examio.ai.v1.AiService, internal network only
REDIS_HOST=redis
REDIS_PASSWORD=
RABBITMQ_AI_PASS= # worker only: amqp://ai:<pass>@rabbitmq:5672

# Database: own role + schema `ai` only (created by deploy/postgres/init/01-service-schemas.sh;
# tables come from Alembic, run by ai-migrate). Password must be URL-safe: openssl rand -hex 24
AI_DB_PASSWORD=
# Built by compose from the password above; shown for reference, do not set.
# DATABASE_URL=postgresql://ai_svc:<AI_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>
# Pinned on every connection (pgvector lives in `extensions`). There is no runtime DDL.
DB_SEARCH_PATH=ai,extensions

# Service-token verification for gRPC (RS256 against the auth JWKS, aud=ai).
# Allowed callers are a code constant (svc:ai-chat, svc:vocabulary, svc:content).
JWT_ISSUER=examio-auth
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json

# Worker: comma-separated hostnames document.uploaded may download from (SSRF allow-list). Presigned
# GET URLs point at the R2 S3 endpoint, so list the host of R2_ENDPOINT (and bucket virtual hosts).
R2_ALLOWED_HOSTS=
R2_PUBLIC_URL=

GEMINI_API_KEYS=
GEMINI_MODEL_NAMES=
AI2_BASE_URL=
AI2_API_KEY=
