# ai - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Python ai-service
PYTHONUNBUFFERED=1
PORT=3000
REDIS_HOST=redis
REDIS_PASSWORD=
RABBITMQ_AI_PASS=

# Database: own role + schema only (created by deploy/postgres/init/01-service-schemas.sh).
# Password must be URL-safe (it is embedded in the URL): openssl rand -hex 24
AI_DB_PASSWORD=
# Built by compose from the password above; shown for reference, do not set.
# DATABASE_URL=postgresql://ai_svc:<AI_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>

# Tables are still exam-owned until phase 15: keep exam,extensions now, then ai,extensions.
DB_SEARCH_PATH=exam,extensions
# Schema changes ship as Prisma migrations; leave false (runtime CREATE TABLE/INDEX is skipped).
AI_RUNTIME_DDL=false
GEMINI_API_KEYS=
GEMINI_MODEL_NAMES=
AI2_BASE_URL=
AI2_API_KEY=
