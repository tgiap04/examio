# vocabulary - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Shared by every service container (compose sets these inline)
NODE_ENV=production
PORT=3000
# gRPC server: WordFamilyAdminService (admin-service) + WordFamilyService (exam-service)
GRPC_PORT=50051
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json

# CORS allowlist for the browser origin
FRONTEND_URL=

# Database: own role + schema only (created by deploy/postgres/init/01-service-schemas.sh).
# Password must be URL-safe (it is embedded in the URL): openssl rand -hex 24
VOCABULARY_DB_PASSWORD=
# Built by compose from the password above; shown for reference, do not set.
# DATABASE_URL=postgresql://vocabulary_svc:<VOCABULARY_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=vocabulary

# Cache + per-user daily generation counter (keys under prefix vocab:)
REDIS_HOST=redis
REDIS_PASSWORD=
# api + the r2_delete_tasks worker (category images) in one container
ROLE=api,worker
R2_GRPC_URL=r2:50051
# Public base of R2 objects (tells an R2-hosted category image from an external URL)
R2_PUBLIC_URL=
# Temporary until phase 13: word-family generation calls ai-service over HTTP
AI_SERVICE_URL=http://ai:3000/api
INTERNAL_SERVICE_TOKEN=
# Service token for r2 DeleteObjects (as svc:vocabulary; auth holds only the hash)
AUTH_TOKEN_URL=http://auth:3000/internal/token
VOCABULARY_SERVICE_CLIENT_SECRET=
# No RabbitMQ: vocabulary publishes and consumes no events.
