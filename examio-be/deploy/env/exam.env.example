# exam - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Shared by every service container (compose sets these inline)
NODE_ENV=production
PORT=3000
GRPC_PORT=50051
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json

# Database: own role + schema only (created by deploy/postgres/init/01-service-schemas.sh).
# Password must be URL-safe (it is embedded in the URL): openssl rand -hex 24
EXAM_DB_PASSWORD=
# Built by compose from the password above; shown for reference, do not set.
# DATABASE_URL=postgresql://exam_svc:<EXAM_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=exam

# exam-service is the legacy schema owner until phases 12-15 split it up.
REDIS_HOST=redis
REDIS_PASSWORD=
RABBITMQ_EXAM_PASS=
AI_SERVICE_URL=http://ai:3000/api
R2_SERVICE_URL=r2:3000
ROLE=api,worker
R2_GRPC_URL=r2:50051
# Public base URL of R2 objects. Only URLs under it are treated as ours: replaced or
# deleted avatars/thumbnails are queued for deletion; unset => nothing is ever deleted.
R2_PUBLIC_URL=
FINANCE_GRPC_URL=finance:50051
AUTH_GRPC_URL=auth:50051
AUTH_TOKEN_URL=http://auth:3000/internal/token
EXAM_SERVICE_CLIENT_SECRET=
QUIZ_JWT_SECRET=
QUIZ_AES_KEY=
TURNSTILE_SECRET_KEY=
