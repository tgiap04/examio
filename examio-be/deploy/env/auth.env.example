# auth - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Shared by every service container (compose sets these inline)
NODE_ENV=production
PORT=3000
GRPC_PORT=50051
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json

# Database: own role + schema only (created by deploy/postgres/init/01-service-schemas.sh).
# Password must be URL-safe (it is embedded in the URL): openssl rand -hex 24
AUTH_DB_PASSWORD=
# Built by compose from the password above; shown for reference, do not set.
# DATABASE_URL=postgresql://auth_svc:<AUTH_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=auth

REDIS_HOST=redis
REDIS_PASSWORD=
RABBITMQ_AUTH_PASS=
ROLE=api,worker
R2_GRPC_URL=r2:50051
# Public base URL of R2 objects. Only URLs under it are treated as ours: replaced or
# deleted avatars/thumbnails are queued for deletion; unset => nothing is ever deleted.
R2_PUBLIC_URL=
JWT_PRIVATE_KEY=
JWT_KID=
JWT_RETIRED_PUBLIC_KEYS=
# JSON {"<name>":"<sha256>"}: exam, studyroom, vocabulary, document, ai-chat, finance, admin, gateway (scripts/gen-service-secret.sh <name>)
SERVICE_CLIENTS=
GATEWAY_CONTROL_ENABLED=true
GATEWAY_GRPC_URL=gateway:50051
ADMIN_EMAILS=
ADMIN_DEFAULT_PASSWORD=
EMAIL_USER=
EMAIL_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FRONTEND_URL=
