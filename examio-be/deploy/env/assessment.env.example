# assessment (assessment-service) - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Exam rooms, sessions (with a quiz snapshot), attempts and cheating logs. HTTP only, no gRPC server.
# Shared by every service container (compose sets these inline)
NODE_ENV=production
PORT=3000
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json

# CORS allowlist for the browser origin
FRONTEND_URL=

# Database: own role + schema only (created by deploy/postgres/init/01-service-schemas.sh).
# Password must be URL-safe (it is embedded in the URL): openssl rand -hex 24
ASSESSMENT_DB_PASSWORD=
# Built by compose from the password above; shown for reference, do not set.
# DATABASE_URL=postgresql://assessment_svc:<ASSESSMENT_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=assessment

REDIS_HOST=redis
REDIS_PASSWORD=
# Broker user `assessment`: consumes assessment.events (content.quizset.deleted, auth.user.updated),
# may publish assessment.* only.
RABBITMQ_ASSESSMENT_PASS=
# api serves HTTP; worker relays the outbox and runs the daily purge (no listener of its own).
ROLE=api,worker
# ContentService (snapshots, quiz set titles and question counts) as the caller's forwarded user token;
# DocumentService (history stats); auth public profiles. Never called while an exam runs.
CONTENT_GRPC_URL=content:50051
DOCUMENT_GRPC_URL=document:50051
AUTH_GRPC_URL=auth:50051
# Service token (as svc:assessment; auth holds only the hash, under the client name `assessment`)
AUTH_TOKEN_URL=http://auth:3000/internal/token
ASSESSMENT_SERVICE_CLIENT_SECRET=
QUIZ_JWT_SECRET=
QUIZ_AES_KEY=
TURNSTILE_SECRET_KEY=
