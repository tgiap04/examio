# content (content-service) - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Quiz sets, flashcards, practice and the AI generation jobs (charge, refund, watchdog).
# Shared by every service container (compose sets these inline)
NODE_ENV=production
PORT=3000
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json

# CORS allowlist for the browser origin
FRONTEND_URL=

# Database: own role + schema only (created by deploy/postgres/init/01-service-schemas.sh).
# Password must be URL-safe (it is embedded in the URL): openssl rand -hex 24
CONTENT_DB_PASSWORD=
# Built by compose from the password above; shown for reference, do not set.
# DATABASE_URL=postgresql://content_svc:<CONTENT_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=content

REDIS_HOST=redis
REDIS_PASSWORD=
# Broker user `content`: publishes content.* (generation requests, quiz set deletions) through the outbox;
# consumes content.events (ai.generation.completed|failed, auth.user.updated, document.deleted).
RABBITMQ_CONTENT_PASS=
# api serves HTTP + the gRPC ContentService (GRPC_PORT, assessment-service calls it with the user's token);
# worker relays the outbox, settles generation jobs (reaper, refund sweeper, watchdog) and drains r2_delete_tasks.
ROLE=api,worker
GRPC_PORT=50051
# A generation job ai-service has not answered for this long is failed (GENERATION_TIMEOUT) and refunded. Default 60, minimum 10.
GENERATION_JOB_TIMEOUT_MINUTES=60
# Free AI generation for local use; ignored when NODE_ENV=production.
AI_FREE_MODE=false
# finance Debit/Refund; document uploads and ownership; r2 UploadFile/DeleteObjects as svc:content;
# vocabulary word families (to-flashcard bridge); auth public profiles; ai-service ListModels
FINANCE_GRPC_URL=finance:50051
DOCUMENT_GRPC_URL=document:50051
R2_GRPC_URL=r2:50051
VOCABULARY_GRPC_URL=vocabulary:50051
AUTH_GRPC_URL=auth:50051
AI_GRPC_URL=ai:50051
# Public base URL of R2 objects. Only URLs under it are treated as ours: replaced or
# deleted thumbnails/images are queued for deletion; unset => nothing is ever deleted.
R2_PUBLIC_URL=
# Service token (as svc:content; auth holds only the hash, under the client name `content`)
AUTH_TOKEN_URL=http://auth:3000/internal/token
CONTENT_SERVICE_CLIENT_SECRET=
# Cloudflare Turnstile secret (flashcard study/with-code bot check; unset => a sent token fails verification)
TURNSTILE_SECRET_KEY=
