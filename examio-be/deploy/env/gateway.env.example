# gateway-service - deploy/env/gateway.env (copy from this file; never commit the real one).
# Only what gateway-service reads at runtime and compose does NOT set. Compose already sets the wiring
# (ports, DATABASE_URL, REDIS_*, RABBITMQ_URL, *_GRPC_URL, JWT_*, SERVICE_CLIENT_SECRET) from deploy/.env.
# Empty KEY= lines are required values; commented lines are optional tunables with their default.

# Nothing secret: upstream URLs, broker user `gateway`, JWKS and the service token are wired by compose.

# Optional.
# Comma list of allowed browser origins (defaults to FRONTEND_URL).
# CORS_ORIGINS=
# Timeout of the auth-state lookup (ms).
# AUTH_STATE_TIMEOUT_MS=
# Route table override (default config/routes.yaml in the image).
# ROUTES_CONFIG_PATH=
