# gateway - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Shared by every service container (compose sets these inline)
NODE_ENV=production
PORT=3000
GRPC_PORT=50051
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json

# No database: the gateway is a router (Redis for revoke/rate-limit state only).
FRONTEND_URL=
REDIS_HOST=redis
REDIS_PASSWORD=
RABBITMQ_GATEWAY_PASS=
AUTH_SERVICE_URL=http://auth:3000
EXAM_SERVICE_URL=http://exam:3000
FINANCE_SERVICE_URL=http://finance:3000
ADMIN_SERVICE_URL=http://admin:3000
ADMIN_GRPC_URL=admin:50051
AUTH_TOKEN_URL=http://auth:3000/internal/token
GATEWAY_SERVICE_CLIENT_SECRET=
