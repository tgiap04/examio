# document - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Shared by every service container (compose sets these inline)
NODE_ENV=production
PORT=3000
# gRPC server: DocumentService (callers forward the user token; CreateUpload carries up to 50 MB of bytes)
GRPC_PORT=50051
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json

# CORS allowlist for the browser origin
FRONTEND_URL=

# Database: own role + schema only (created by deploy/postgres/init/01-service-schemas.sh).
# Password must be URL-safe (it is embedded in the URL): openssl rand -hex 24
DOCUMENT_DB_PASSWORD=
# Built by compose from the password above; shown for reference, do not set.
# DATABASE_URL=postgresql://document_svc:<DOCUMENT_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=document

# api + worker (outbox relay, document.events consumer, PENDING_CHARGE reaper, r2_delete_tasks) in one container
ROLE=api,worker
# Broker user `document`: publishes only ^document\. on examio.events, reads document.events (+ retry/DLQ).
# Use a URL-safe password (it is embedded in the amqp:// URL).
RABBITMQ_DOCUMENT_PASS=

# r2-service (UploadFile, CreatePresignedDownload, DeleteObjects as svc:document) and
# finance-service (GetUserBenefits, Debit with the forwarded user token, Refund as svc:document)
R2_GRPC_URL=r2:50051
FINANCE_GRPC_URL=finance:50051
# Public base of R2 objects (the `url` stored with each upload)
R2_PUBLIC_URL=
# AI_FREE_MODE=true skips charging outside production (the shared finance client forces it off in production)

# Service token (as svc:document; auth holds only the hash in SERVICE_CLIENTS)
AUTH_TOKEN_URL=http://auth:3000/internal/token
DOCUMENT_SERVICE_CLIENT_SECRET=
# No Redis: the monthly quota is a count of this month's rows.
