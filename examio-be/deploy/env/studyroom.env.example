# study-room - variable NAMES for this service. Values live in deploy/.env (never commit it).
# Shared by every service container (compose sets these inline)
NODE_ENV=production
PORT=3000
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json

# WebSocket CORS allowlist (/ws/study). Required in production: the service refuses to start without it.
FRONTEND_URL=

# Database: own role + schema only (created by deploy/postgres/init/01-service-schemas.sh).
# Password must be URL-safe (it is embedded in the URL): openssl rand -hex 24
STUDYROOM_DB_PASSWORD=
# Built by compose from the password above; shown for reference, do not set.
# DATABASE_URL=postgresql://studyroom_svc:<STUDYROOM_DB_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=studyroom

# Live room state (prefix studyroom:) and the Socket.io Redis adapter (channel key studyroom).
REDIS_HOST=redis
REDIS_PASSWORD=
# Consumer of studyroom.events (auth.user.authz_changed, auth.user.updated); runs in the API process.
RABBITMQ_STUDYROOM_PASS=
# Names/avatars of members (GetPublicProfilesByIds), cached under studyroom:cache:user:<id>.
AUTH_GRPC_URL=auth:50051
AUTH_TOKEN_URL=http://auth:3000/internal/token
STUDYROOM_SERVICE_CLIENT_SECRET=
# No ROLE variable: one process serves HTTP, Socket.io and the event consumer; no gRPC server.
