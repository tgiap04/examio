# Dev Seed Runner - minimal image
# Runs each service's dev seed (auth -> finance -> admin -> ai-chat -> vocabulary) against that
# service's own schema/role and exits. Idempotent: upserts, safe to re-run.
FROM node:22-alpine AS base
# Keep corepack's yarn outside /root/.cache (cleaned below): the seed runs on the
# internal network with no egress, so yarn must never be re-downloaded at runtime.
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable && corepack prepare yarn@4.9.2 --activate
WORKDIR /app

COPY package.json yarn.lock .yarnrc.yml ./
RUN yarn install --immutable && \
    rm -rf /root/.cache /tmp/*

COPY libs ./libs
COPY apps ./apps
COPY proto ./proto
# prisma:generate runs scripts/prisma-generate.sh
COPY scripts ./scripts
COPY tsconfig*.json nest-cli.json ./
# Per-service Prisma clients (gitignored output under apps/<svc>-service/src/generated).
RUN yarn proto:gen && yarn prisma:generate && rm -rf /root/.cache /tmp/*

COPY deploy/entrypoint-seed.sh ./entrypoint-seed.sh
RUN chmod +x ./entrypoint-seed.sh

CMD ["./entrypoint-seed.sh"]
