// finance-service schema (database-per-service, phase 11). No relation or FK may point at
// a model owned by another service: `userId String` + `@@index` instead.
generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    engineType   = "client"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model UserSubscription {
    id              String    @unique
    userId          String    @unique
    tier            Int       @default(0) // 0=none, 1=basic, 2=advanced, 3=vip
    billingCycle    String    @default("monthly") // monthly | yearly
    lastPaymentDate DateTime?
    nextPaymentDate DateTime?
    isActive        Boolean   @default(false)
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    createdBy       String?
    updatedBy       String?
}

model Payment {
    id          String    @unique
    userId      String
    amount      Int
    currency    String
    status      Int // 0=unpaid, 1=paid, 2=overdue, 3=cancelled, 4=refunded
    paymentType String    @default("credits") // credits | subscription
    expiresAt   DateTime? // Payment expires after 10 minutes, null for legacy
    orderId     String? // SePay order ID for VA management
    vaNumber    String? // SePay VA number for cleanup on cancel
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    createdBy   String?
    updatedBy   String?
    // Admin refund de-duplication key: a replay of the same key answers already_applied
    // even when the refund moved no credits (subscription payment / no wallet).
    refundIdempotencyKey String? @unique

    @@index([userId, paymentType, status])
}

model Wallet {
    id        String   @unique
    userId    String   @unique
    balance   Int      @default(0)
    createdBy String?
    updatedBy String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    transactions WalletTransaction[]
}

model WalletTransaction {
    id          String   @unique
    walletId    String
    updatedAt   DateTime @default(now()) @updatedAt
    createdBy   String?
    updatedBy   String?
    amount      Int
    type        Int // 0 = buy credits, 1 = buy subscription, 2 = refund, 3 = admin adjustment, 4 = use services
    direction   String   @default("SUBTRACT") // ADD = cộng credits, SUBTRACT = trừ credits
    description String?
    createdAt   DateTime @default(now())
    // Money RPC de-duplication key (per wallet). NULL for legacy / non-keyed rows.
    idempotencyKey String?
    // Wallet balance right after this transaction (set by Debit/Credit/Refund/admin).
    balanceAfter   Int?

    wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

    @@unique([walletId, idempotencyKey])
}

// Transactional outbox + idempotent-consumer ledger (libs/messaging).
model OutboxEvent {
    seq           BigInt    @id @default(autoincrement())
    id            String    @unique
    source        String
    type          String
    envelope      Json
    attempts      Int       @default(0)
    nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
    lockedUntil   DateTime? @map("locked_until")
    lastError     String?   @map("last_error")
    createdAt     DateTime  @default(now()) @map("created_at")
    publishedAt   DateTime? @map("published_at")

    // The relay's partial index (WHERE published_at IS NULL) lives only in the
    // migration SQL: Prisma cannot express it, and declaring a plain @@index here
    // makes `prisma migrate diff` report permanent drift against the partial one.
    @@map("outbox_events")
}

model ProcessedEvent {
    consumer    String
    eventId     String   @map("event_id")
    processedAt DateTime @default(now()) @map("processed_at")

    @@id([consumer, eventId])
    @@index([processedAt])
    @@map("processed_events")
}
