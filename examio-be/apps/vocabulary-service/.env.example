# Vocabulary Service Environment Variables

# Server
# Local dev only: services share one host, so ports are distinct. In containers
# every service listens on HTTP 3000 / gRPC 50051 (see deploy/compose/vocabulary.yml).
PORT=3010
GRPC_PORT=50055
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# api | worker | api,worker (worker = R2 delete tasks for category images)
ROLE=api,worker

# Database (role vocabulary_svc, schema vocabulary)
DATABASE_URL="postgresql://vocabulary_svc:password@localhost:5432/examio?schema=vocabulary"

# Redis (cache + daily generation counter, prefix vocab:)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# gRPC: r2-service DeleteObjects (worker)
R2_GRPC_URL=localhost:50054
# Public base of R2 objects (tells an R2-hosted category image from an external URL)
R2_PUBLIC_URL=

# gRPC: ai-service AiService.GenerateWordFamily (service token svc:vocabulary)
AI_GRPC_URL=localhost:50051

# Stateless auth (@examio/auth-jwt): tokens are verified against auth's JWKS.
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Service-to-service tokens (this service's own secret; auth only holds its hash).
AUTH_TOKEN_URL=http://localhost:3001/internal/token
SERVICE_CLIENT_SECRET=<printed-by-gen-service-secret>
