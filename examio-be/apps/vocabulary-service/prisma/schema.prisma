// vocabulary-service schema (database-per-service, phase 12). Postgres schema `vocabulary`,
// role `vocabulary_svc`. No relation or FK may point at a model owned by another service:
// `userId String` + `@@index` instead.
generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    engineType   = "client"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// R2 objects (category images) queued for deletion in the same tx as the row change;
// the worker role (libs/messaging r2-delete) drains it. Raw SQL: `r2_delete_tasks`.
model R2DeleteTask {
    id            String   @id @default(uuid()) @db.Uuid
    key           String
    attempts      Int      @default(0)
    nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
    lastError     String?  @map("last_error")
    createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    @@index([nextAttemptAt])
    @@map("r2_delete_tasks")
}


// Word Family Category — seeded by admin, used to organize root words
model WordFamilyCategory {
    id          String   @id @default(cuid())
    name        String   @unique
    slug        String   @unique
    description String?
    imageUrl    String?
    order       Int      @default(0)
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    wordFamilies WordFamily[]

    @@index([isActive, order])
}

// Word Family — AI-generated cache of word variants for a root word in a category
model WordFamily {
    id           String   @id @default(cuid())
    rootWord     String
    categoryId   String
    categorySlug String
    data         Json
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    category WordFamilyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    savedByUsers UserSavedWordFamily[]

    @@unique([rootWord, categorySlug])
    @@index([categorySlug])
    @@index([categoryId])
    @@index([rootWord])
}

// User's saved word families — reference-based, O(1) lookup
model UserSavedWordFamily {
    id           String   @id @default(cuid())
    userId       String
    wordFamilyId String
    savedAt      DateTime @default(now())

    wordFamily WordFamily @relation(fields: [wordFamilyId], references: [id], onDelete: Cascade)

    @@unique([userId, wordFamilyId])
    @@index([userId])
    @@index([wordFamilyId])
}
