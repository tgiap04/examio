# Exam Service Environment Variables

# Server
# Local dev only: services share one host, so ports are distinct. In containers
# every service listens on HTTP 3000 + gRPC 50051 (see deploy/docker-compose.yml).
PORT=3002
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/examio_db"

# Quiz Security (for encrypted questions)
QUIZ_JWT_SECRET=your_quiz_jwt_secret_32_chars_min
QUIZ_AES_KEY=your_aes_256_key_32_characters_

# Redis (for caching exam sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# gRPC Services
R2_GRPC_URL=localhost:50054
FINANCE_GRPC_URL=localhost:50053

# Stateless auth (@examio/auth-jwt): tokens are verified against auth's JWKS.
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Service-to-service tokens (this service's own secret; auth only holds its hash).
AUTH_TOKEN_URL=http://localhost:3001/internal/token
SERVICE_CLIENT_SECRET=<printed-by-gen-service-secret>
