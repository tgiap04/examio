// exam-service legacy schema: CONTENT domain (extracted to content-service in phase 12).
// No relation to User: userId is a plain column with an index.

model QuizSet {
    id          String   @id @default(cuid())
    title       String
    description String?
    userId      String
    thumbnail   String?
    isPublic    Boolean  @default(false)
    isPinned    Boolean  @default(false)
    tags        String[] @default([])
    accessCode  String? // 6-digit invite code; null = code access off
    whitelist   String[] @default([]) // user ids granted by the owner
    codeGrantedIds String[] @default([]) // user ids that unlocked with the current code (cleared on rotate/disable)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now()) @updatedAt
    createdBy   String?
    updatedBy   String?

    detailsQuizQuestions DetailsQuizQuestion[]
    examRooms            ExamRoom[]
    practiceAttempts     QuizPracticeAttempt[]
    labels               QuizSetLabel[]

    @@index([whitelist], type: Gin)
    @@index([codeGrantedIds], type: Gin)

    @@index([userId])
}

// Label for organizing questions within a QuizSet (e.g., Chapter 1, Chapter 2, etc.)
model QuizSetLabel {
    id          String   @id @default(cuid())
    quizSetId   String
    name        String   // Label name (e.g., "Chương 1", "Phần A")
    description String?  // Optional description
    color       String?  // Optional color for UI display (hex code)
    order       Int      @default(0) // For ordering labels in UI
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now()) @updatedAt

    quizSet              QuizSet               @relation(fields: [quizSetId], references: [id], onDelete: Cascade)
    detailsQuizQuestions DetailsQuizQuestion[]

    @@unique([quizSetId, name]) // Unique label name per quizset
    @@index([quizSetId])
}

// Label for organizing flashcards within a FlashCardSet (e.g., Chapter 1, Chapter 2, etc.)
model FlashCardSetLabel {
    id             String   @id @default(cuid())
    flashCardSetId String
    name           String   // Label name (e.g., "Chương 1", "Phần A")
    description    String?  // Optional description
    color          String?  // Optional color for UI display (hex code)
    order          Int      @default(0) // For ordering labels in UI
    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now()) @updatedAt

    flashCardSet       FlashCardSet       @relation(fields: [flashCardSetId], references: [id], onDelete: Cascade)
    detailsFlashCards DetailsFlashCard[]

    @@unique([flashCardSetId, name]) // Unique label name per flashcardset
    @@index([flashCardSetId])
}

model FlashCardSet {
    id          String   @id @default(cuid())
    title       String
    userId      String
    thumbnail   String?
    description String?
    tag         String[] @default([])
    isPublic    Boolean  @default(false)
    isPinned    Boolean  @default(false)
    viewCount   Int      @default(0)
    accessCode  String? // 6-digit code for private access
    whitelist   String[] @default([]) // List of user IDs who can access
    codeGrantedIds String[] @default([]) // user ids that unlocked with the current code (cleared on rotate/disable)
    createdAt   DateTime @default(now())
    updatedBy   String?
    createdBy   String?
    updatedAt   DateTime @default(now()) @updatedAt

    detailsFlashCard DetailsFlashCard[]
    labels           FlashCardSetLabel[]
    viewHistories          FlashCardViewHistory[]
    userPins               UserPinnedFlashcard[]
    flashcardStudyProgress FlashcardStudyProgress[]

    @@index([accessCode])

    @@index([userId])
}

model QuizQuestion {
    id        String   @id @default(cuid())
    question  String
    options   String[]
    answer    String
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    detailsQuizQuestions DetailsQuizQuestion[]
}

model DetailsQuizQuestion {
    id                      String  @id @default(cuid())
    quizSetId               String
    quizQuestionId          String
    historyGeneratedQuizzId String?
    labelId                 String? // Optional: link to QuizSetLabel for categorization

    quizSet               QuizSet                @relation(fields: [quizSetId], references: [id], onDelete: Cascade)
    quizQuestion          QuizQuestion           @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    historyGeneratedQuizz HistoryGeneratedQuizz? @relation(fields: [historyGeneratedQuizzId], references: [id], onDelete: SetNull)
    label                 QuizSetLabel?          @relation(fields: [labelId], references: [id], onDelete: SetNull)

    @@unique([quizSetId, quizQuestionId])
    @@index([quizSetId])
    @@index([quizQuestionId])
    @@index([historyGeneratedQuizzId])
    @@index([labelId])
}

model FlashCard {
    id        String   @id @default(cuid())
    question  String
    answer    String
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    detailsFlashCards DetailsFlashCard[]
}

model DetailsFlashCard {
    id                          String  @id @default(cuid())
    flashCardSetId              String
    flashCardId                 String
    historyGeneratedFlashcardId String?
    labelId                     String? // Optional: link to FlashCardSetLabel for categorization

    flashCardSet              FlashCardSet               @relation(fields: [flashCardSetId], references: [id], onDelete: Cascade)
    flashCard                 FlashCard                  @relation(fields: [flashCardId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    historyGeneratedFlashcard HistoryGeneratedFlashcard? @relation(fields: [historyGeneratedFlashcardId], references: [id], onDelete: SetNull)
    label                     FlashCardSetLabel?         @relation(fields: [labelId], references: [id], onDelete: SetNull)

    @@unique([flashCardSetId, flashCardId])
    @@index([flashCardSetId])
    @@index([flashCardId])
    @@index([historyGeneratedFlashcardId])
    @@index([labelId])
}

model HistoryGeneratedQuizz {
    id            String   @id @default(cuid())
    userId        String
    userStorageId String?
    quizzes       Json
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now()) @updatedAt

    userStorage          UserStorage?          @relation(fields: [userStorageId], references: [id], onDelete: SetNull)
    detailsQuizQuestions DetailsQuizQuestion[]

    @@index([userId])
}

model HistoryGeneratedFlashcard {
    id            String   @id @default(cuid())
    userId        String
    userStorageId String?
    flashcards    Json
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now()) @updatedAt

    userStorage       UserStorage?       @relation(fields: [userStorageId], references: [id], onDelete: SetNull)
    detailsFlashCards DetailsFlashCard[]

    @@index([userId])
}

model FlashCardViewHistory {
    id             String   @id @default(cuid())
    userId         String
    flashCardSetId String
    viewedAt       DateTime @default(now())
    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now()) @updatedAt

    flashCardSet FlashCardSet @relation(fields: [flashCardSetId], references: [id], onDelete: Cascade)

    @@index([userId, viewedAt])
    @@index([flashCardSetId])
}

model UserPinnedFlashcard {
    id             String   @id @default(cuid())
    userId         String
    flashcardSetId String
    pinnedAt       DateTime @default(now())

    flashcardSet FlashCardSet @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)

    @@unique([userId, flashcardSetId])
    @@index([userId, pinnedAt])
}

model FlashcardStudyProgress {
    id             String   @id @default(cuid())
    userId         String
    flashCardSetId String
    studiedCardIds String[] @default([])
    totalCards     Int      @default(0)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now()) @updatedAt

    flashCardSet FlashCardSet @relation(fields: [flashCardSetId], references: [id], onDelete: Cascade)

    @@unique([userId, flashCardSetId])
    @@index([userId])
    @@index([flashCardSetId])
}
