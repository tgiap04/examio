// exam-service legacy schema: DOCUMENT domain (UserStorage, upload quota; extracted in phase 15).
// No relation to User: userId is a plain column with an index.

model UserStorage {
    id               String   @unique
    userId           String
    filename         String
    url              String
    mimetype         String
    size             Int
    keyR2            String   @unique
    createdAt        DateTime @default(now())
    updatedAt        DateTime @default(now()) @updatedAt
    processingStatus String   @default("COMPLETED") // PENDING | PROCESSING | COMPLETED | FAILED
    creditCharged    Boolean  @default(false) // Track if OCR credit was already deducted

    documents                 Document[]
    documentEntities          DocumentEntity[]
    graphState                UserStorageGraph?
    graphGroups               UserStorageGraphGroup[]
    historyGeneratedQuizz     HistoryGeneratedQuizz[]
    historyGeneratedFlashcard HistoryGeneratedFlashcard[]
    aiChatDocuments           AIChatDocument[]

    @@index([userId])
}

// Track monthly file uploads for subscription limits
model UserMonthlyFileUpload {
    id        String   @id @default(cuid())
    userId    String
    yearMonth String // Format: "2024-12" for efficient monthly grouping
    count     Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, yearMonth])
    @@index([userId, yearMonth])
}
