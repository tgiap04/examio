// exam-service legacy schema: generator, datasource and the messaging/R2 tables.
// Domain models live in the sibling files (one owner file per future service);
// Prisma merges the whole folder: `prisma <cmd> --schema apps/exam-service/prisma/schema`.
generator client {
    provider     = "prisma-client"
    output       = "../../src/generated/prisma"
    engineType   = "client"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Transactional outbox + idempotent-consumer ledger (libs/messaging).
model OutboxEvent {
    seq           BigInt    @id @default(autoincrement())
    id            String    @unique
    source        String
    type          String
    envelope      Json
    attempts      Int       @default(0)
    nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
    lockedUntil   DateTime? @map("locked_until")
    lastError     String?   @map("last_error")
    createdAt     DateTime  @default(now()) @map("created_at")
    publishedAt   DateTime? @map("published_at")

    // The relay's partial index (WHERE published_at IS NULL) lives only in the
    // migration SQL: Prisma cannot express it, and declaring a plain @@index here
    // makes `prisma migrate diff` report permanent drift against the partial one.
    @@map("outbox_events")
}

model ProcessedEvent {
    consumer    String
    eventId     String   @map("event_id")
    processedAt DateTime @default(now()) @map("processed_at")

    @@id([consumer, eventId])
    @@index([processedAt])
    @@map("processed_events")
}

// Durable R2 object deletion queue (written in the same tx as the row delete /
// image replace; drained by the ROLE=worker). Holds object keys, never URLs.
model R2DeleteTask {
    id            String   @id @default(uuid()) @db.Uuid
    key           String
    attempts      Int      @default(0)
    nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
    lastError     String?  @map("last_error")
    createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    @@index([nextAttemptAt])
    @@map("r2_delete_tasks")
}
