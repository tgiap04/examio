// exam-service legacy schema: tables read/written by ai-service (python) until phase 15.
// No relation to User: userId is a plain column with an index.

model Document {
    id            String                @unique
    userStorageId String
    pageRange     String
    title         String?
    content       String
    embeddings    Unsupported("vector")

    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @default(now()) @updatedAt
    userStorage UserStorage @relation(fields: [userStorageId], references: [id], onDelete: Cascade)

    @@index([userStorageId, createdAt])
}

model DocumentEntity {
    id            String   @id
    userStorageId String
    chunkId       String?
    name          String
    type          String
    description   String   @default("")
    relatedNames  Json     @default("[]")
    createdAt     DateTime @default(now())

    userStorage UserStorage @relation(fields: [userStorageId], references: [id], onDelete: Cascade)

    @@index([userStorageId])
    @@index([name, type])
}

model UserStorageGraph {
    id               String   @id @default(cuid())
    userStorageId    String   @unique
    graphVersion     Int      @default(1)
    chunkSignature   String
    status           String   @default("READY")
    totalChunks      Int      @default(0)
    totalEdges       Int      @default(0)
    totalCommunities Int      @default(0)
    totalGroups      Int      @default(0)
    metadata         Json?
    builtAt          DateTime @default(now())
    updatedAt        DateTime @default(now()) @updatedAt

    userStorage UserStorage            @relation(fields: [userStorageId], references: [id], onDelete: Cascade)
    groups      UserStorageGraphGroup[]

    @@index([status])
}

model UserStorageGraphGroup {
    id             String   @id @default(cuid())
    graphId        String
    userStorageId  String
    groupIndex     Int
    communityId    Int?
    pageStart      Int?
    pageEnd        Int?
    pageRanges     Json
    chunkIds       Json
    estimatedTokens Int    @default(0)
    charCount      Int      @default(0)
    weight         Float    @default(1)
    summary        String?
    metadata       Json?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now()) @updatedAt

    graph       UserStorageGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)
    userStorage UserStorage      @relation(fields: [userStorageId], references: [id], onDelete: Cascade)

    @@unique([graphId, groupIndex])
    @@index([userStorageId, groupIndex])
}
