# Study Room Service Environment Variables

# Server
# Local dev only: services share one host, so ports are distinct. In containers
# every service listens on HTTP 3000 (see deploy/compose/study-room.yml).
PORT=3009
NODE_ENV=development
# WebSocket CORS allowlist (required in production)
FRONTEND_URL=http://localhost:5173

# Database (role studyroom_svc, schema studyroom)
DATABASE_URL="postgresql://studyroom_svc:password@localhost:5432/examio?schema=studyroom"

# Redis (live room state + Socket.io adapter, prefix studyroom:)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (queue studyroom.events: auth.user.authz_changed, auth.user.updated)
RABBITMQ_URL=amqp://studyroom:password@localhost:5672

# gRPC: auth public profiles (names/avatars)
AUTH_GRPC_URL=localhost:50051

# Stateless auth (@examio/auth-jwt): tokens are verified against auth's JWKS.
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Service-to-service tokens (this service's own secret; auth only holds its hash).
AUTH_TOKEN_URL=http://localhost:3001/internal/token
SERVICE_CLIENT_SECRET=<printed-by-gen-service-secret>
