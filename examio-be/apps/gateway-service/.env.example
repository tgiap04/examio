# Gateway Service Environment Variables

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Services URLs (local dev)
AUTH_SERVICE_URL=http://localhost:3001
EXAM_SERVICE_URL=http://localhost:3002
STUDYROOM_SERVICE_URL=http://localhost:3009
VOCABULARY_SERVICE_URL=http://localhost:3010
DOCUMENT_SERVICE_URL=http://localhost:3011
AICHAT_SERVICE_URL=http://localhost:3012
FINANCE_SERVICE_URL=http://localhost:3003
ADMIN_SERVICE_URL=http://localhost:7006

# Redis (for rate limiting session storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Stateless auth (@examio/auth-jwt): tokens are verified against auth's JWKS.
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
