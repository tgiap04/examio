// auth-service schema (database-per-service, phase 11). Owns identity only:
// no relation or FK may point at a model owned by another service. Other
// services keep a plain `userId String` + `@@index` instead of a User relation.
generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    engineType   = "client"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Base role of an account. STUDENT and TEACHER are mutually exclusive;
// SYSTEM_ADMIN is the separate `isSystemAdmin` flag and combines with either.
enum BaseRole {
    STUDENT
    TEACHER
}

model User {
    id         String   @unique
    email      String   @unique
    username   String   @unique
    name       String?
    avatar     String?
    banner     String?
    bio        String?
    role          BaseRole @default(STUDENT)
    isSystemAdmin Boolean  @default(false)
    // Monotonic authz version (JWT claim `av`): bumped in the same tx as every
    // role / admin-flag / ban / password change so stale tokens are detectable.
    authzVersion  Int      @default(0)
    isVerified Boolean  @default(false)
    isBanned   Boolean  @default(false)
    deletedAt  DateTime?
    password   String?
    utmSource  String?  @db.VarChar(64) // nguồn first-touch lúc đăng ký (utm_source); null = direct
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
    createdBy  String?
    updatedBy  String?

    verifyAccountCode VerifyAccountCode?
    resetPasswordCode ResetPasswordCode?
    sessions          UserSession[]

    @@index([utmSource])
    @@index([role])
    @@index([isSystemAdmin])
}

model VerifyAccountCode {
    id        String   @unique
    userId    String   @unique
    code      String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResetPasswordCode {
    id        String   @unique
    userId    String   @unique
    code      String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
    id            String   @id
    userId        String
    sessionId     String   @unique
    refreshToken  String   @unique // Token để refresh access token
    // Token cũ ngay trước lần rotate gần nhất, còn dùng được trong grace window
    // để tránh tự đăng xuất khi nhiều tab/nhiều request refresh song song.
    previousRefreshToken   String?   @unique
    previousTokenExpiresAt DateTime?
    deviceId      String
    deviceName    String?
    browser       String?
    os            String?
    ipAddress     String?
    country       String?
    city          String?
    isActive      Boolean  @default(true)
    lastActivity  DateTime @default(now())
    createdAt     DateTime @default(now())
    expiresAt     DateTime
    updatedAt     DateTime @default(now()) @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, isActive])
    @@index([userId, deviceId])
    @@index([refreshToken])
    @@index([previousRefreshToken])
}

// Audit trail of every role / admin-flag change. No foreign keys: rows must
// outlive the accounts they describe (emails are snapshotted).
model RoleChangeLog {
    id          String   @id
    targetUserId String
    targetEmail String
    actorUserId String?
    actorEmail  String
    fromRole    BaseRole
    toRole      BaseRole
    fromAdmin   Boolean
    toAdmin     Boolean
    reason      String?
    // 'admin-ui' | 'cli' | 'bootstrap'
    source      String
    createdAt   DateTime @default(now())

    @@index([targetUserId, createdAt(sort: Desc)])
    @@index([createdAt(sort: Desc)])
}

// Transactional outbox (libs/messaging). One copy per service schema.
model OutboxEvent {
    seq           BigInt    @id @default(autoincrement())
    id            String    @unique
    source        String
    type          String
    envelope      Json
    attempts      Int       @default(0)
    nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
    lockedUntil   DateTime? @map("locked_until")
    lastError     String?   @map("last_error")
    createdAt     DateTime  @default(now()) @map("created_at")
    publishedAt   DateTime? @map("published_at")

    // The relay's partial index (WHERE published_at IS NULL) lives only in the
    // migration SQL: Prisma cannot express it, and declaring a plain @@index here
    // makes `prisma migrate diff` report permanent drift against the partial one.
    @@map("outbox_events")
}

// Idempotent-consumer ledger (libs/messaging). The relay's purge job deletes
// from it too, so every schema that runs a relay carries it.
model ProcessedEvent {
    consumer    String
    eventId     String   @map("event_id")
    processedAt DateTime @default(now()) @map("processed_at")

    @@id([consumer, eventId])
    @@index([processedAt])
    @@map("processed_events")
}

// Durable R2 object deletion queue (written in the same tx as the row delete /
// image replace; drained by the ROLE=worker). Holds object keys, never URLs.
model R2DeleteTask {
    id            String   @id @default(uuid()) @db.Uuid
    key           String
    attempts      Int      @default(0)
    nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
    lastError     String?  @map("last_error")
    createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    @@index([nextAttemptAt])
    @@map("r2_delete_tasks")
}
