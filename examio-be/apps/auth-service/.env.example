# Auth Service Environment Variables

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173/

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/examio_db"

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_32_chars
# Refresh tokens are encrypted at rest with this key (AES-256). Min 32 chars,
# distinct per environment. Rotating it invalidates existing refresh tokens.
REFRESH_TOKEN_ENC_KEY=your_refresh_token_enc_key_min_32_chars
ACCESS_TOKEN_EXPIRATION=15m

# Mail Configuration
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_or_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Comma-separated allowlist of app-scheme/origin OAuth redirect targets.
# Only these are allowed to receive a one-time OAuth token-exchange code
# after Google login (prevents open-redirect/account-takeover via an
# attacker-supplied redirect target). Custom schemes match by scheme only
# (e.g. "examio://"); http(s) entries match the exact origin.
OAUTH_ALLOWED_APP_REDIRECTS=examio://,https://app.examio.com

# Redis (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# gRPC Services
WALLET_GRPC_URL=localhost:50053
R2_GRPC_URL=localhost:50054
