# Auth Service Environment Variables

# Server
# Local dev only: services share one host, so ports are distinct. In containers
# every service listens on HTTP 3000 + gRPC 50051 (see deploy/docker-compose.yml).
PORT=3001
GRPC_PORT=50051
NODE_ENV=development
FRONTEND_URL=http://localhost:5173/

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/examio_db"

# JWT Configuration (RS256 + JWKS). Generate the key with
# scripts/gen-jwt-keypair.sh (prints JWT_KID and JWT_PRIVATE_KEY); never commit it.
JWT_PRIVATE_KEY=<pkcs8-pem-one-line-with-\n-escapes>
JWT_KID=<kid-printed-by-gen-jwt-keypair>
# Rotation: keep the OLD public key published while its tokens are alive.
# JSON [{"kid":"...","pem":"-----BEGIN PUBLIC KEY-----\n..."}]
JWT_RETIRED_PUBLIC_KEYS=
JWT_ISSUER=examio-auth
JWT_AUDIENCE=examio
# Service tokens (client_credentials at POST /internal/token): name -> sha256 hex
# of that service's secret. See scripts/gen-service-secret.sh <name>.
SERVICE_CLIENTS={"content":"<sha256-hex>","assessment":"<sha256-hex>","studyroom":"<sha256-hex>","finance":"<sha256-hex>","admin":"<sha256-hex>","vocabulary":"<sha256-hex>","document":"<sha256-hex>","ai-chat":"<sha256-hex>"}
# Fast-path RevokeSession / InvalidateUser calls into the gateway's GatewayControl
# gRPC server (compose turns this on; keep false when running auth alone).
GATEWAY_CONTROL_ENABLED=false
# GATEWAY_GRPC_URL=localhost:50051
# SYSTEM_ADMIN bootstrap (synced on auth start-up and by `yarn bootstrap:admin`)
ADMIN_EMAILS=admin@example.com
ADMIN_DEFAULT_PASSWORD=
# Refresh tokens are encrypted at rest with this key (AES-256). Min 32 chars,
# distinct per environment. Rotating it invalidates existing refresh tokens.
REFRESH_TOKEN_ENC_KEY=your_refresh_token_enc_key_min_32_chars
ACCESS_TOKEN_EXPIRATION=15m

# Mail Configuration
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_or_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Comma-separated allowlist of app-scheme/origin OAuth redirect targets.
# Only these are allowed to receive a one-time OAuth token-exchange code
# after Google login (prevents open-redirect/account-takeover via an
# attacker-supplied redirect target). Custom schemes match by scheme only
# (e.g. "examio://"); http(s) entries match the exact origin.
OAUTH_ALLOWED_APP_REDIRECTS=examio://,https://app.examio.com

# Redis (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# gRPC Services
R2_GRPC_URL=localhost:50054
