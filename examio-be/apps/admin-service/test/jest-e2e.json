{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "app\\.e2e-spec\\.ts$",
  "//": "admin.e2e-spec.ts is excluded until Phase 04 rewrites it for the RBAC admin surface (its file list already includes it). Do not delete.",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@examio/database(.*)$": "<rootDir>/../../../libs/database/src/$1",
    "^@examio/common(.*)$": "<rootDir>/../../../libs/common/src/$1",
    "^@examio/redis(.*)$": "<rootDir>/../../../libs/redis/src/$1",
    "^@examio/observability(.*)$": "<rootDir>/../../../libs/observability/src/$1"
  },
  "testTimeout": 60000,
  "forceExit": true
}
