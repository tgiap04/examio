// admin-service schema (database-per-service, phase 11). No relation or FK may point at
// a model owned by another service: `userId String` + `@@index` instead.
generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    engineType   = "client"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model AdminAudit {
    id        String   @id @default(cuid())
    adminId   String
    action    String
    targetId  String?
    payload   Json?
    reason    String?
    ipAddress String?
    userAgent String?
    createdAt DateTime @default(now())

    @@index([adminId, createdAt(sort: Desc)])
    @@index([action, createdAt(sort: Desc)])
}

/// Cờ bật/tắt trang hiển thị cho user (global, do admin điều khiển).
/// `key` là một trong TOGGLEABLE_PAGE_KEYS (@examio/common). Mặc định bật.
model PageFeatureFlag {
    key       String   @id
    label     String
    enabled   Boolean  @default(true)
    updatedAt DateTime @updatedAt
}


// Transactional outbox + idempotent-consumer ledger (libs/messaging).
model OutboxEvent {
    seq           BigInt    @id @default(autoincrement())
    id            String    @unique
    source        String
    type          String
    envelope      Json
    attempts      Int       @default(0)
    nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
    lockedUntil   DateTime? @map("locked_until")
    lastError     String?   @map("last_error")
    createdAt     DateTime  @default(now()) @map("created_at")
    publishedAt   DateTime? @map("published_at")

    // The relay's partial index (WHERE published_at IS NULL) lives only in the
    // migration SQL: Prisma cannot express it, and declaring a plain @@index here
    // makes `prisma migrate diff` report permanent drift against the partial one.
    @@map("outbox_events")
}

model ProcessedEvent {
    consumer    String
    eventId     String   @map("event_id")
    processedAt DateTime @default(now()) @map("processed_at")

    @@id([consumer, eventId])
    @@index([processedAt])
    @@map("processed_events")
}
