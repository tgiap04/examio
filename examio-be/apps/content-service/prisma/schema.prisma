// content-service schema (database-per-service, phase 14). Postgres schema `content`, role
// `content_svc`. No relation or FK may point at a model owned by another service: `userId String`,
// `storageId String` (document-service) and the assessment-side `quizSetId` are plain columns.
generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    engineType   = "client"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Transactional outbox + idempotent-consumer ledger (libs/messaging).
model OutboxEvent {
    seq           BigInt    @id @default(autoincrement())
    id            String    @unique
    source        String
    type          String
    envelope      Json
    attempts      Int       @default(0)
    nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
    lockedUntil   DateTime? @map("locked_until")
    lastError     String?   @map("last_error")
    createdAt     DateTime  @default(now()) @map("created_at")
    publishedAt   DateTime? @map("published_at")

    // The relay's partial index (WHERE published_at IS NULL) lives only in the
    // migration SQL: Prisma cannot express it, and declaring a plain @@index here
    // makes `prisma migrate diff` report permanent drift against the partial one.
    @@map("outbox_events")
}

model ProcessedEvent {
    consumer    String
    eventId     String   @map("event_id")
    processedAt DateTime @default(now()) @map("processed_at")

    @@id([consumer, eventId])
    @@index([processedAt])
    @@map("processed_events")
}

// Durable R2 object deletion queue (written in the same tx as the row delete /
// image replace; drained by the ROLE=worker). Holds object keys, never URLs.
model R2DeleteTask {
    id            String   @id @default(uuid()) @db.Uuid
    key           String
    attempts      Int      @default(0)
    nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
    lastError     String?  @map("last_error")
    createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    @@index([nextAttemptAt])
    @@map("r2_delete_tasks")
}

// ---- Content domain: quiz sets, flashcard sets, practice, study progress ----

model QuizSet {
    id          String   @id @default(cuid())
    title       String
    description String?
    userId      String
    thumbnail   String?
    isPublic    Boolean  @default(false)
    isPinned    Boolean  @default(false)
    tags        String[] @default([])
    accessCode  String? // 6-digit invite code; null = code access off
    whitelist   String[] @default([]) // user ids granted by the owner
    codeGrantedIds String[] @default([]) // user ids that unlocked with the current code (cleared on rotate/disable)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now()) @updatedAt
    createdBy   String?
    updatedBy   String?

    detailsQuizQuestions DetailsQuizQuestion[]
    practiceAttempts     QuizPracticeAttempt[]
    labels               QuizSetLabel[]

    @@index([whitelist], type: Gin)
    @@index([codeGrantedIds], type: Gin)

    @@index([userId])
}

// Label for organizing questions within a QuizSet (e.g., Chapter 1, Chapter 2, etc.)
model QuizSetLabel {
    id          String   @id @default(cuid())
    quizSetId   String
    name        String   // Label name (e.g., "Chương 1", "Phần A")
    description String?  // Optional description
    color       String?  // Optional color for UI display (hex code)
    order       Int      @default(0) // For ordering labels in UI
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now()) @updatedAt

    quizSet              QuizSet               @relation(fields: [quizSetId], references: [id], onDelete: Cascade)
    detailsQuizQuestions DetailsQuizQuestion[]

    @@unique([quizSetId, name]) // Unique label name per quizset
    @@index([quizSetId])
}

// Label for organizing flashcards within a FlashCardSet (e.g., Chapter 1, Chapter 2, etc.)
model FlashCardSetLabel {
    id             String   @id @default(cuid())
    flashCardSetId String
    name           String   // Label name (e.g., "Chương 1", "Phần A")
    description    String?  // Optional description
    color          String?  // Optional color for UI display (hex code)
    order          Int      @default(0) // For ordering labels in UI
    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now()) @updatedAt

    flashCardSet       FlashCardSet       @relation(fields: [flashCardSetId], references: [id], onDelete: Cascade)
    detailsFlashCards DetailsFlashCard[]

    @@unique([flashCardSetId, name]) // Unique label name per flashcardset
    @@index([flashCardSetId])
}

model FlashCardSet {
    id          String   @id @default(cuid())
    title       String
    userId      String
    thumbnail   String?
    description String?
    tag         String[] @default([])
    isPublic    Boolean  @default(false)
    isPinned    Boolean  @default(false)
    viewCount   Int      @default(0)
    accessCode  String? // 6-digit code for private access
    whitelist   String[] @default([]) // List of user IDs who can access
    codeGrantedIds String[] @default([]) // user ids that unlocked with the current code (cleared on rotate/disable)
    createdAt   DateTime @default(now())
    updatedBy   String?
    createdBy   String?
    updatedAt   DateTime @default(now()) @updatedAt

    detailsFlashCard DetailsFlashCard[]
    labels           FlashCardSetLabel[]
    viewHistories          FlashCardViewHistory[]
    userPins               UserPinnedFlashcard[]
    flashcardStudyProgress FlashcardStudyProgress[]

    @@index([accessCode])

    @@index([userId])
}

model QuizQuestion {
    id        String   @id @default(cuid())
    question  String
    options   String[]
    answer    String
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    detailsQuizQuestions DetailsQuizQuestion[]
}

model DetailsQuizQuestion {
    id                      String  @id @default(cuid())
    quizSetId               String
    quizQuestionId          String
    historyGeneratedQuizzId String?
    labelId                 String? // Optional: link to QuizSetLabel for categorization

    quizSet               QuizSet                @relation(fields: [quizSetId], references: [id], onDelete: Cascade)
    quizQuestion          QuizQuestion           @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    historyGeneratedQuizz HistoryGeneratedQuizz? @relation(fields: [historyGeneratedQuizzId], references: [id], onDelete: SetNull)
    label                 QuizSetLabel?          @relation(fields: [labelId], references: [id], onDelete: SetNull)

    @@unique([quizSetId, quizQuestionId])
    @@index([quizSetId])
    @@index([quizQuestionId])
    @@index([historyGeneratedQuizzId])
    @@index([labelId])
}

model FlashCard {
    id        String   @id @default(cuid())
    question  String
    answer    String
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    detailsFlashCards DetailsFlashCard[]
}

model DetailsFlashCard {
    id                          String  @id @default(cuid())
    flashCardSetId              String
    flashCardId                 String
    historyGeneratedFlashcardId String?
    labelId                     String? // Optional: link to FlashCardSetLabel for categorization

    flashCardSet              FlashCardSet               @relation(fields: [flashCardSetId], references: [id], onDelete: Cascade)
    flashCard                 FlashCard                  @relation(fields: [flashCardId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    historyGeneratedFlashcard HistoryGeneratedFlashcard? @relation(fields: [historyGeneratedFlashcardId], references: [id], onDelete: SetNull)
    label                     FlashCardSetLabel?         @relation(fields: [labelId], references: [id], onDelete: SetNull)

    @@unique([flashCardSetId, flashCardId])
    @@index([flashCardSetId])
    @@index([flashCardId])
    @@index([historyGeneratedFlashcardId])
    @@index([labelId])
}

model HistoryGeneratedQuizz {
    id            String   @id @default(cuid())
    userId        String
    userStorageId String?
    quizzes       Json
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now()) @updatedAt

    detailsQuizQuestions DetailsQuizQuestion[]

    @@index([userId])
    // Document in document-service (no FK): nulled by `document.deleted`, read by `recent-uploads`
    @@index([userStorageId])
}

model HistoryGeneratedFlashcard {
    id            String   @id @default(cuid())
    userId        String
    userStorageId String?
    flashcards    Json
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now()) @updatedAt

    detailsFlashCards DetailsFlashCard[]

    @@index([userId])
    // Document in document-service (no FK): nulled by `document.deleted`, read by `recent-uploads`
    @@index([userStorageId])
}

model FlashCardViewHistory {
    id             String   @id @default(cuid())
    userId         String
    flashCardSetId String
    viewedAt       DateTime @default(now())
    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now()) @updatedAt

    flashCardSet FlashCardSet @relation(fields: [flashCardSetId], references: [id], onDelete: Cascade)

    @@index([userId, viewedAt])
    @@index([flashCardSetId])
}

model UserPinnedFlashcard {
    id             String   @id @default(cuid())
    userId         String
    flashcardSetId String
    pinnedAt       DateTime @default(now())

    flashcardSet FlashCardSet @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)

    @@unique([userId, flashcardSetId])
    @@index([userId, pinnedAt])
}

model FlashcardStudyProgress {
    id             String   @id @default(cuid())
    userId         String
    flashCardSetId String
    studiedCardIds String[] @default([])
    totalCards     Int      @default(0)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now()) @updatedAt

    flashCardSet FlashCardSet @relation(fields: [flashCardSetId], references: [id], onDelete: Cascade)

    @@unique([userId, flashCardSetId])
    @@index([userId])
    @@index([flashCardSetId])
}

model QuizPracticeAttempt {
    id              String   @id @default(cuid())
    quizSetId       String
    userId          String
    type            Int      @default(0) // 0: PRACTICE (thi thử), 1: REAL (thi thật)
    answers         Json     @default("{}") // { questionId: selectedAnswer }
    currentIndex    Int      @default(0) // Câu hỏi hiện tại
    markedQuestions String[] @default([]) // Danh sách câu hỏi đánh dấu

    // Thời gian làm bài
    timeSpentSeconds Int  @default(0) // Thời gian đã làm (giây)
    timeLimitMinutes Int? // Giới hạn thời gian (phút), null = không giới hạn

    // Trạng thái
    isSubmitted    Boolean @default(false)
    score          Float? // Điểm sau khi nộp bài
    totalQuestions Int     @default(0)
    correctAnswers Int     @default(0)
    // Frozen at submit: per-question result (question text, options, pick, key, verdict) so later edits to the set never change a past result
    resultSnapshot Json?

    // Timestamps
    startedAt   DateTime  @default(now())
    submittedAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @default(now()) @updatedAt
    createdBy   String?
    updatedBy   String?

    quizSet QuizSet @relation(fields: [quizSetId], references: [id], onDelete: Cascade)

    // History: many attempts per user and set (the old unique allowed one row only)
    @@index([quizSetId, userId, isSubmitted])
    @@index([userId])
    @@index([quizSetId])
    @@index([userId, updatedAt(sort: Desc)])
}

// ---- Generation domain: quiz / flashcard generation from an uploaded document ----

// One AI generation request.
//
//   QUEUED --ai.generation.completed--> COMPLETED
//     |  \--ai.generation.failed / watchdog--> FAILED
//     \--cancel--------------------------------> CANCELLED
//
// The job is inserted QUEUED together with its `content.generation.requested` outbox row (one
// transaction). Every transition is a conditional update, so racing paths settle each job once.
model GenerationJob {
    id         String   @id
    userId     String
    // The document to generate from (`UserStorage.id` in document-service).
    storageId  String
    filename   String
    // quiz | flashcard
    type       String
    // QUEUED | PROCESSING | COMPLETED | FAILED | CANCELLED
    status     String   @default("QUEUED")
    // { numItems, isNarrowSearch, keyword? } of `content.generation.requested`
    options    Json
    model      String?
    error      String?
    // The HistoryGeneratedQuizz / HistoryGeneratedFlashcard row of a COMPLETED job.
    historyId  String?
    createdAt  DateTime @default(now())
    updatedAt  DateTime @default(now()) @updatedAt

    @@index([userId, storageId, createdAt(sort: Desc)])
    @@index([status, createdAt])
}
