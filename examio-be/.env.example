# Core
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://examio.vn

# Security
JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_SECRET=change_this_to_another_secure_string
REFRESH_TOKEN_EXPIRATION=7d
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Quiz Security (assessment-service)
QUIZ_JWT_SECRET=change_this_to_quiz_secret_32_chars_min
QUIZ_AES_KEY=change_this_to_aes_key_32_chars_min

# PostgreSQL Container Configuration
POSTGRES_USER=examio
POSTGRES_PASSWORD=examio_password_change_this
POSTGRES_DB=examio

# Database (PostgreSQL) - Docker Container
# The DATABASE_URL should use 'postgres' as the hostname (Docker service name)
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis - Docker Container
# Use 'redis' as hostname (Docker service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_a_secure_redis_password

# RabbitMQ (Message Queue)
RABBITMQ_USER=examio_mq
RABBITMQ_PASS=change_this_to_a_secure_rabbitmq_password
RABBITMQ_URL=amqp://examio_mq:change_this_to_a_secure_rabbitmq_password@rabbitmq:5672

# ============ AI Service Configuration ============
GEMINI_API_KEYS=key1,key2
GEMINI_MODEL_NAMES=gemini-2.0-flash,gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=sk-...

# Gemini Embedding
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
RAG_MODEL=gemini

# AI Settings
DEFAULT_MODEL_TYPE=gemini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048

# ============ OCR Service Configuration ============
# olmocr Path (Relative or Absolute path. Use forward slashes / for Windows)
OLMOCR_PATH=C:/Users/902/kma/olmocr

# GPU Configuration (for NVIDIA card like RTX 5060 Ti)
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Python OCR service URL (Internal)
OCR_PYTHON_SERVICE_URL=http://ocr-python:8003/api/ocr/process

# ============ R2 Storage (Cloudflare) ============
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=examio
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-....r2.dev

# ============ Payment (SePay) ============
PAYMENT_SERVICE_SEPAY_KEY=
PAYMENT_BASE_URL=https://my.sepay.vn
PAYMENT_QR_BANK_ACCOUNT=
PAYMENT_QR_BANK_CODE=
PAYMENT_WEBHOOK_SECRET_KEY=

# ============ Mail Configuration ============
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# ============ OAuth Providers ============
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.examio.vn/api/v1/auth/google/callback

# ============ Service URLs (Internal Docker Network) ============
# Do not change these unless you rename services in docker-compose
AUTH_SERVICE_URL=http://auth:3000
CONTENT_SERVICE_URL=http://content:3000
ASSESSMENT_SERVICE_URL=http://assessment:3000
FINANCE_SERVICE_URL=http://finance:3000
ADMIN_SERVICE_URL=http://admin:3000
GATEWAY_URL=http://gateway:3000

# gRPC Configuration (Internal)
AUTH_GRPC_URL=auth:50051
R2_GRPC_URL=r2:50051
FINANCE_GRPC_URL=finance:50051

# ============ AI2 Content Generation (OpenAI-compatible) ============
# Used only for quiz/flashcard/content generation. Do not use AI2 for OCR embeddings.
AI2_BASE_URL=link-to-ai2-service
AI2_API_KEY=key-for-ai2
AI2_GENERATION_MODEL_NAMES=model1,model2,model3
AI2_DEFAULT_MODEL=model1
AI2_TIMEOUT_SECONDS=3600
AI2_MAX_TOKENS=4096

# AI streaming performance limits
DEFAULT_MAX_TOKENS_CAP=4096
TUTOR_FAST_RETRIEVAL_TIMEOUT_SECONDS=0.5
CHAT_HISTORY_MAX_MESSAGES=4
CHAT_HISTORY_MAX_CHARS=1200
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ============ Admin Service ============
# Comma-separated list of admin emails (used by bootstrap on startup)
ADMIN_EMAILS=admin@examio.vn
# Default password for NEW admin users created by bootstrap (min 16 chars).
# ALSO consumed by `yarn run seed:dev` so seeded users share the same
# password as bootstrap-created admins. Override per-run with SEED_PASSWORD.
ADMIN_DEFAULT_PASSWORD=change_this_to_a_unique_admin_password_min_16_chars
# Rate limit: requests per minute per admin
THROTTLE_ADMIN_LIMIT=30
